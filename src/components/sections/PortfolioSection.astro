---
import Container from "../common/Container.astro";
import Section from "../common/Section.astro";

interface Props {
  id: string;
  eyebrow: string;
  title: string;
  description: string;
}

const { id, eyebrow, title, description } = Astro.props;
---

<Section
  id={id}
  class="relative isolate scroll-mt-20 overflow-hidden bg-black"
>
  <Container>
    <div class="max-w-3xl">
      <p class="section-eyebrow text-violet-300">
        {eyebrow}
      </p>

      <h2 class="interactive-heading section-title mt-6 text-slate-400">
        {title}
      </h2>

      <p class="body-copy-reference mt-8 max-w-2xl text-slate-300">
        {description}
      </p>

      <slot />
    </div>
  </Container>
</Section>
