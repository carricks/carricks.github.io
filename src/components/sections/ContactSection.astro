---
import { siteProfile } from "../../config/site";
import { contactAccessKey } from "../../config/contact";
import Container from "../common/Container.astro";
import Section from "../common/Section.astro";
import ArrowIcon from "../common/ArrowIcon.astro";
import type { Locale } from "../../i18n/home";
import { getContactContent } from "../../i18n/contact";

interface Props {
  locale?: Locale;
}

const { locale = "en" } = Astro.props;
const content = getContactContent(locale);
---

<Section id="contact" class="relative isolate scroll-mt-20 overflow-hidden bg-black pb-24 lg:pb-24">
  <Container>
    <div class="max-w-2xl">
      <p class="section-eyebrow text-violet-300">{content.eyebrow}</p>
      <h2 class="interactive-heading section-title mt-6 text-slate-400">{content.title}</h2>
      <p class="body-copy-reference mt-6 max-w-xl text-slate-300">{content.description}</p>

      <form data-contact-form data-invalid-message={content.invalid} data-subject-prefix={content.subject}
        data-sending-message={content.sending} data-success-message={content.success} data-failure-message={content.failure}
        data-timeout-message={content.timeout} data-unavailable-message={content.unavailable} data-submit-message={content.submit}
        novalidate class="contact-panel mt-8" aria-describedby="contact-form-status">
        <input type="hidden" name="access_key" value={contactAccessKey} />
        <input type="hidden" name="from_name" value="Diego Carrillo · Portfolio" />
        <input type="hidden" name="page_language" value={locale} />
        <input type="checkbox" name="botcheck" class="contact-botcheck" tabindex="-1" aria-hidden="true" />
        <div class="contact-fields">
        <div class="contact-field">
          <label for="contact-name">{content.name}</label>
          <div class="contact-input-wrap">
          <span class="contact-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7">
              <circle cx="12" cy="8" r="3.25" />
              <path d="M4.5 20c.9-3.65 3.3-5.5 7.5-5.5s6.6 1.85 7.5 5.5" />
            </svg>
          </span>
          <input id="contact-name" name="name" type="text" autocomplete="name" required maxlength="120" data-contact-input
            data-required-message={content.nameRequired} data-length-message={content.tooLong} aria-describedby="contact-name-error" />
          </div>
          <p id="contact-name-error" class="contact-error" aria-live="polite"></p>
        </div>
        <div class="contact-field">
          <label for="contact-email">{content.email}</label>
          <div class="contact-input-wrap">
          <span class="contact-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7">
              <rect x="3.5" y="5.5" width="17" height="13" rx="1.5" />
              <path d="m4.5 7 7.5 5.5L19.5 7" />
            </svg>
          </span>
          <input id="contact-email" name="email" type="email" autocomplete="email" required maxlength="254" data-contact-input
            data-required-message={content.emailRequired} data-invalid-message={content.emailInvalid} data-length-message={content.tooLong} aria-describedby="contact-email-error" />
          </div>
          <p id="contact-email-error" class="contact-error" aria-live="polite"></p>
        </div>
        <div class="contact-field contact-field-message">
          <label for="contact-message">{content.message}</label>
          <div class="contact-input-wrap">
          <span class="contact-icon contact-message-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7">
              <path d="M5 5.5h14A1.5 1.5 0 0 1 20.5 7v9A1.5 1.5 0 0 1 19 17.5H10l-4.5 3v-3H5A1.5 1.5 0 0 1 3.5 16V7A1.5 1.5 0 0 1 5 5.5Z" />
            </svg>
          </span>
          <textarea id="contact-message" name="message" rows="5" required maxlength="5000" data-contact-input
            data-required-message={content.messageRequired} data-length-message={content.tooLong} aria-describedby="contact-message-error"></textarea>
          </div>
          <p id="contact-message-error" class="contact-error" aria-live="polite"></p>
        </div>
        </div>

        <p id="contact-form-status" data-contact-status class="min-h-6 text-[length:var(--type-ui-size)] leading-[var(--type-ui-line-height)]" aria-live="polite"></p>
        <button type="submit" class="interactive-control neon-box-control premium-neon-control contact-submit">
          <span class="neon-box-label">{content.submit}</span>
          <ArrowIcon />
        </button>
        <noscript><p class="contact-error">{content.noScript}</p></noscript>
      </form>

    </div>
  </Container>

  <footer class="contact-footer" aria-label={content.footerLabel}>
    <Container>
      <div class="contact-footer-content">
        <div class="footer-profiles" aria-label={content.profilesLabel}>
          <a class="interactive-control social-link" href={siteProfile.githubUrl} target="_blank" rel="noopener noreferrer" aria-label={content.githubLabel}>
            <svg aria-hidden="true" viewBox="0 0 24 24" fill="currentColor">
              <path d="M12 2C6.48 2 2 6.58 2 12.23c0 4.52 2.87 8.35 6.84 9.7.5.1.68-.22.68-.49 0-.24-.01-1.04-.01-1.89-2.78.62-3.37-1.2-3.37-1.2-.45-1.19-1.11-1.5-1.11-1.5-.91-.64.07-.63.07-.63 1 .08 1.54 1.06 1.54 1.06.9 1.57 2.35 1.12 2.92.86.09-.67.35-1.12.64-1.38-2.22-.26-4.56-1.14-4.56-5.06 0-1.12.39-2.03 1.04-2.75-.1-.26-.45-1.31.1-2.73 0 0 .85-.28 2.75 1.05A9.36 9.36 0 0 1 12 6.94c.85 0 1.7.12 2.5.34 1.9-1.33 2.74-1.05 2.74-1.05.55 1.42.2 2.47.1 2.73.65.72 1.04 1.63 1.04 2.75 0 3.93-2.35 4.8-4.58 5.05.36.32.68.92.68 1.85 0 1.34-.01 2.42-.01 2.75 0 .27.18.59.69.49A10.24 10.24 0 0 0 22 12.23C22 6.58 17.52 2 12 2Z" />
            </svg>
          </a>
          <a class="interactive-control social-link" href={siteProfile.linkedinUrl} target="_blank" rel="noopener noreferrer" aria-label={content.linkedinLabel}>
            <svg aria-hidden="true" viewBox="0 0 24 24" fill="currentColor">
              <path d="M5.37 3.75A1.87 1.87 0 1 1 1.63 3.75a1.87 1.87 0 0 1 3.74 0ZM2 8h3.45v11H2V8Zm5.61 0h3.31v1.5h.05c.46-.87 1.58-1.79 3.25-1.79 3.48 0 4.12 2.29 4.12 5.27V19h-3.45v-5.02c0-1.2-.02-2.74-1.67-2.74-1.67 0-1.93 1.3-1.93 2.65V19H7.84V8Z" />
            </svg>
          </a>
        </div>
        <div class="footer-credits">
          <a class="footer-copyright" href="https://www.government.nl/themes/economy/intellectual-property/protection-of-intellectual-property" target="_blank" rel="noopener noreferrer" aria-label={content.copyrightLabel}>
            <span aria-hidden="true">&copy;</span>
            <span>{content.copyright}</span>
          </a>
          <a class="interactive-control codex-link" href="https://developers.openai.com/" target="_blank" rel="noopener noreferrer" aria-label={content.codexLabel}>
            <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7">
              <path d="m9 6-6 6 6 6M15 6l6 6-6 6M14 4l-4 16" />
            </svg>
            <span>Codex</span>
          </a>
        </div>
      </div>
    </Container>
  </footer>
</Section>

<style>
  .contact-panel {
    border: 1px solid rgba(167, 139, 250, 0.28);
    border-radius: 1rem;
    background: rgba(167, 139, 250, 0.025);
    padding: clamp(1.25rem, 3vw, 2rem);
  }
  .contact-fields { display: grid; gap: 1rem 1.25rem; grid-template-columns: minmax(0, 1fr); }
  .contact-field { min-width: 0; }
  .contact-input-wrap { position: relative; }
  .contact-field label {
    color: rgb(196 181 253); display: block; margin-bottom: 0.5rem;
    font-size: inherit; font-weight: 400; line-height: inherit;
  }
  .contact-error { color: #fca5a5; font-size: var(--type-caption-size); line-height: 1.6; margin-top: 0.4rem; }
  .contact-error:empty { display: none; }
  [data-contact-status] { margin: 1rem 0 0.75rem; color: rgb(196 181 253); }
  [data-contact-status][data-state="error"] { color: #fca5a5; }
  .contact-botcheck { display: none; }
  .contact-submit:disabled { opacity: 0.65; cursor: wait; }
  @media (min-width: 48rem) {
    .contact-fields { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .contact-field-message { grid-column: 1 / -1; }
  }
  .contact-icon {
    color: rgb(167 139 250);
    left: 1rem;
    pointer-events: none;
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    transition: color 160ms ease, filter 160ms ease;
  }
  .contact-icon svg { display: block; height: 1.15rem; shape-rendering: geometricPrecision; width: 1.15rem; }
  .contact-message-icon { top: 1.25rem; transform: none; }
  .contact-field input, .contact-field textarea {
    width: 100%; border: 1px solid rgba(167, 139, 250, 0.48); border-radius: 0.65rem;
    background: rgba(76, 29, 149, 0.08); caret-color: rgb(167 139 250); color: rgb(167 139 250); font: inherit; outline: none; padding: 0.9rem 1rem 0.9rem 3rem;
    transition: border-color 160ms ease, box-shadow 160ms ease, background-color 160ms ease;
  }
  .contact-field input::placeholder, .contact-field textarea::placeholder { color: rgba(167, 139, 250, 0.56); }
  .contact-field textarea { min-height: 8rem; resize: vertical; }
  .contact-field:hover input, .contact-field:hover textarea,
  .contact-field input:focus, .contact-field textarea:focus {
    background: rgba(76, 29, 149, 0.12);
    border-color: rgba(196, 181, 253, 0.8);
    box-shadow: 0 0 0 3px rgba(167, 139, 250, 0.14);
    caret-color: rgb(167 139 250);
    color: rgb(167 139 250);
  }
  .contact-field.is-invalid input, .contact-field.is-invalid textarea { border-color: rgb(248 113 113);  }
  .contact-submit {
    width: min(100%, 20rem); background: transparent; border-color: rgba(167, 139, 250, 0.48); color: rgb(221 214 254); cursor: pointer; font: inherit; font-weight: 400;
  }
  .contact-submit:hover {
    color: rgb(196 181 253);
  }
  .contact-footer {
    align-items: center;
    border-top: 1px solid rgba(196, 181, 253, 0.2);
    border-bottom: 1px solid rgba(196, 181, 253, 0.12);
    background: rgba(3, 3, 5, 0.8);
    backdrop-filter: blur(12px);
    bottom: 0;
    left: 0;
    opacity: 0.8;
    padding: 0.9rem 0;
    position: absolute;
    right: 0;
    transition: background-color 220ms ease, border-color 220ms ease, box-shadow 220ms ease, opacity 220ms ease;
    animation: footer-arrival 620ms 180ms both cubic-bezier(0.22, 1, 0.36, 1);
  }
  .contact-footer::before, .contact-footer::after {
    background: linear-gradient(90deg, transparent 0%, rgba(196, 181, 253, 0.72) 24%, rgba(221, 214, 254, 0.95) 50%, rgba(196, 181, 253, 0.72) 76%, transparent 100%);
    content: "";
    height: 1px;
    left: 0;
    opacity: 0;
    pointer-events: none;
    position: absolute;
    right: 0;
    transition: opacity 220ms ease;
  }
  .contact-footer::before { top: -1px; }
  .contact-footer::after { bottom: -1px; }
  .contact-footer:hover, .contact-footer:focus-within {
    background: rgba(3, 3, 5, 0.97);
    border-color: rgba(196, 181, 253, 0.58);
    box-shadow: 0 -1px 16px rgba(167, 139, 250, 0.2), 0 1px 16px rgba(167, 139, 250, 0.16);
    opacity: 1;
  }
  .contact-footer:hover::before, .contact-footer:hover::after, .contact-footer:focus-within::before, .contact-footer:focus-within::after { opacity: 1; }
  .contact-footer-content {
    align-items: center;
    display: flex;
    flex-wrap: wrap;
    gap: 0.9rem 1.5rem;
    justify-content: center;
    position: relative;
  }
  .footer-profiles { display: flex; gap: 0.75rem; }
  .social-link {
    align-items: center;
    border: 1px solid rgba(221, 214, 254, 0.3);
    border-radius: 0.7rem;
    background: rgb(196 181 253);
    color: rgb(24 24 27);
    display: inline-flex;
    height: 2.35rem;
    justify-content: center;
    width: 2.35rem;
  }
  .social-link svg { height: 1.05rem; width: 1.05rem; }
  .footer-credits {
    align-items: center;
    color: rgb(148 163 184);
    display: flex;
    flex-wrap: wrap;
    font-family: var(--font-sans);
    font-size: var(--type-caption-size);
    font-style: normal;
    gap: 0.8rem;
    letter-spacing: 0.02em;
  }
  .footer-copyright {
    align-items: center;
    display: inline-flex;
    gap: 0.35rem;
    transition: color 160ms ease;
  }
  .footer-copyright:hover {
    animation: footer-link-presence 520ms cubic-bezier(0.22, 1, 0.36, 1);
    color: rgb(221 214 254);
  }
  .codex-link {
    align-items: center;
    color: rgb(148 163 184);
    display: inline-flex;
    gap: 0.35rem;
    padding: 0.2rem;
    transition: color 160ms ease;
  }
  .interactive-control.codex-link:hover {
    animation: footer-link-presence 520ms cubic-bezier(0.22, 1, 0.36, 1);
    background: transparent;
    border-color: transparent;
    box-shadow: none;
    color: rgb(196 181 253);
    transform: none;
  }
  .codex-link svg { height: 1rem; width: 1rem; }
  @keyframes footer-link-presence {
    0% { opacity: 0.7; transform: translateY(1px); }
    42% { opacity: 1; transform: translateY(-1px); }
    68% { opacity: 0.84; transform: translateY(0); }
    100% { opacity: 1; transform: translateY(0); }
  }
  @keyframes footer-arrival {
    from { opacity: 0; transform: translateY(0.75rem); }
    to { opacity: 0.8; transform: translateY(0); }
  }
  @media (max-width: 48rem) {
    .contact-footer { position: static; margin-top: 2rem; }
    .contact-footer-content { align-items: center; flex-direction: column; }
    .footer-credits { justify-content: center; text-align: center; }
  }
  @media (prefers-reduced-motion: reduce) {
    .contact-field.is-invalid input, .contact-field.is-invalid textarea, .contact-submit, .contact-footer, .footer-copyright:hover, .interactive-control.codex-link:hover { animation: none; transition: none; }
  }
</style>

<script>
  import "../../scripts/contact";
</script>
