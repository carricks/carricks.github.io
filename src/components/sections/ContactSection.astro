---
import { Image } from "astro:assets";
import contactBackground from "../../assets/contact-topology-v1.png";
import { siteProfile } from "../../config/site";
import Container from "../common/Container.astro";
import Section from "../common/Section.astro";
---

<Section id="contact" class="relative isolate min-h-[calc(100svh-5rem)] scroll-mt-20 overflow-hidden bg-black py-16 pb-28 lg:py-20 lg:pb-28">
  <Image src={contactBackground} alt="" aria-hidden="true" class="absolute inset-0 -z-20 h-full w-full object-cover object-center" />
  <div aria-hidden="true" class="absolute inset-0 -z-10 bg-[linear-gradient(90deg,rgba(0,0,0,0.97)_0%,rgba(0,0,0,0.91)_52%,rgba(0,0,0,0.48)_100%)]" />

  <Container>
    <div class="max-w-2xl">
      <p class="text-sm font-medium tracking-[0.22em] text-violet-300">CONTACT</p>
      <h2 class="mt-6 text-4xl font-semibold tracking-tight text-slate-400 sm:text-5xl">Let’s build resilient systems.</h2>
      <p class="mt-6 max-w-xl text-lg leading-8 text-slate-300">For technical conversations, collaborations and engineering opportunities.</p>

      <form data-contact-form novalidate class="mt-8 grid gap-4" aria-describedby="contact-form-status">
        <div class="contact-field">
          <label class="sr-only" for="contact-name">Name</label>
          <span class="contact-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7">
              <circle cx="12" cy="8" r="3.25" />
              <path d="M4.5 20c.9-3.65 3.3-5.5 7.5-5.5s6.6 1.85 7.5 5.5" />
            </svg>
          </span>
          <input id="contact-name" name="name" type="text" autocomplete="name" required />
        </div>
        <div class="contact-field">
          <label class="sr-only" for="contact-email">Email</label>
          <span class="contact-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7">
              <rect x="3.5" y="5.5" width="17" height="13" rx="1.5" />
              <path d="m4.5 7 7.5 5.5L19.5 7" />
            </svg>
          </span>
          <input id="contact-email" name="email" type="email" autocomplete="email" required />
        </div>
        <div class="contact-field">
          <label class="sr-only" for="contact-message">Message</label>
          <span class="contact-icon contact-message-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7">
              <path d="M5 5.5h14A1.5 1.5 0 0 1 20.5 7v9A1.5 1.5 0 0 1 19 17.5H10l-4.5 3v-3H5A1.5 1.5 0 0 1 3.5 16V7A1.5 1.5 0 0 1 5 5.5Z" />
            </svg>
          </span>
          <textarea id="contact-message" name="message" rows="5" required></textarea>
        </div>

        <p id="contact-form-status" data-contact-status class="min-h-6 text-sm" aria-live="polite"></p>
        <button type="submit" class="interactive-control contact-submit">Submit</button>
      </form>

    </div>
  </Container>

  <footer class="contact-footer" aria-label="Portfolio credits and professional profiles">
    <Container>
      <div class="contact-footer-content">
        <div class="footer-profiles" aria-label="Professional profiles">
          <a class="interactive-control social-link" href={siteProfile.githubUrl} target="_blank" rel="noreferrer" aria-label="Open GitHub profile in a new tab">
            <svg aria-hidden="true" viewBox="0 0 24 24" fill="currentColor">
              <path d="M12 2C6.48 2 2 6.58 2 12.23c0 4.52 2.87 8.35 6.84 9.7.5.1.68-.22.68-.49 0-.24-.01-1.04-.01-1.89-2.78.62-3.37-1.2-3.37-1.2-.45-1.19-1.11-1.5-1.11-1.5-.91-.64.07-.63.07-.63 1 .08 1.54 1.06 1.54 1.06.9 1.57 2.35 1.12 2.92.86.09-.67.35-1.12.64-1.38-2.22-.26-4.56-1.14-4.56-5.06 0-1.12.39-2.03 1.04-2.75-.1-.26-.45-1.31.1-2.73 0 0 .85-.28 2.75 1.05A9.36 9.36 0 0 1 12 6.94c.85 0 1.7.12 2.5.34 1.9-1.33 2.74-1.05 2.74-1.05.55 1.42.2 2.47.1 2.73.65.72 1.04 1.63 1.04 2.75 0 3.93-2.35 4.8-4.58 5.05.36.32.68.92.68 1.85 0 1.34-.01 2.42-.01 2.75 0 .27.18.59.69.49A10.24 10.24 0 0 0 22 12.23C22 6.58 17.52 2 12 2Z" />
            </svg>
          </a>
          <a class="interactive-control social-link" href={siteProfile.linkedinUrl} target="_blank" rel="noreferrer" aria-label="Open LinkedIn profile in a new tab">
            <svg aria-hidden="true" viewBox="0 0 24 24" fill="currentColor">
              <path d="M5.37 3.75A1.87 1.87 0 1 1 1.63 3.75a1.87 1.87 0 0 1 3.74 0ZM2 8h3.45v11H2V8Zm5.61 0h3.31v1.5h.05c.46-.87 1.58-1.79 3.25-1.79 3.48 0 4.12 2.29 4.12 5.27V19h-3.45v-5.02c0-1.2-.02-2.74-1.67-2.74-1.67 0-1.93 1.3-1.93 2.65V19H7.84V8Z" />
            </svg>
          </a>
        </div>
        <div class="footer-credits">
          <a class="footer-copyright" href="https://www.government.nl/themes/economy/intellectual-property/protection-of-intellectual-property" aria-label="Read official Dutch government information about copyright">
            <span aria-hidden="true">&copy;</span>
            <span>2026 Diego Carrillo, all rights reserved</span>
          </a>
          <a class="interactive-control codex-link" href="https://developers.openai.com/" aria-label="Learn more about Codex">
            <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7">
              <path d="m9 6-6 6 6 6M15 6l6 6-6 6M14 4l-4 16" />
            </svg>
            <span>Codex</span>
          </a>
        </div>
      </div>
    </Container>
  </footer>
</Section>

<style>
  .contact-field { position: relative; }
  .contact-icon {
    color: rgb(196 181 253);
    left: 1rem;
    pointer-events: none;
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
  }
  .contact-icon svg { display: block; height: 1.15rem; width: 1.15rem; }
  .contact-message-icon { top: 1.25rem; transform: none; }
  .contact-field input, .contact-field textarea {
    width: 100%; border: 1px solid rgba(196, 181, 253, 0.24); border-radius: 0.75rem;
    background: rgba(3, 3, 5, 0.68); color: white; font: inherit; outline: none; padding: 0.9rem 1rem 0.9rem 3rem;
    transition: border-color 160ms ease, box-shadow 160ms ease, background-color 160ms ease;
  }
  .contact-field textarea { min-height: 8rem; resize: vertical; }
  .contact-field input:focus, .contact-field textarea:focus { border-color: rgba(196, 181, 253, 0.8); box-shadow: 0 0 0 3px rgba(167, 139, 250, 0.14); }
  .contact-field.is-invalid input, .contact-field.is-invalid textarea { border-color: rgb(248 113 113); background: rgba(69, 10, 10, 0.34); animation: invalid-field 850ms ease-in-out 2; }
  .contact-submit {
    width: fit-content; border: 1px solid rgba(221, 214, 254, 0.3); border-radius: 0.75rem;
    background: rgb(196 181 253); color: rgb(24 24 27); cursor: pointer; font: inherit; font-weight: 600;
    padding: 0.8rem 1.5rem; transition: background-color 160ms ease, transform 160ms ease;
  }
  .contact-submit:hover {
    border-color: rgb(196 181 253);
    background: rgba(3, 3, 5, 0.82);
    box-shadow: 0 0 0 3px rgba(196, 181, 253, 0.12);
    color: rgb(196 181 253);
    transform: translateY(-2px);
  }
  .contact-footer {
    align-items: center;
    border-top: 1px solid rgba(196, 181, 253, 0.2);
    background: rgba(3, 3, 5, 0.8);
    backdrop-filter: blur(12px);
    bottom: 0;
    left: 0;
    opacity: 0.8;
    padding: 0.9rem 0;
    position: absolute;
    right: 0;
    transition: background-color 220ms ease, opacity 220ms ease;
    animation: footer-arrival 620ms 180ms both cubic-bezier(0.22, 1, 0.36, 1);
  }
  .contact-footer:hover, .contact-footer:focus-within { background: rgba(3, 3, 5, 0.97); opacity: 1; }
  .contact-footer-content {
    align-items: center;
    display: flex;
    flex-wrap: wrap;
    gap: 0.9rem 1.5rem;
    justify-content: center;
  }
  .footer-profiles { display: flex; gap: 0.75rem; }
  .social-link {
    align-items: center;
    border: 1px solid rgba(221, 214, 254, 0.3);
    border-radius: 0.7rem;
    background: rgb(196 181 253);
    color: rgb(24 24 27);
    display: inline-flex;
    height: 2.35rem;
    justify-content: center;
    width: 2.35rem;
  }
  .social-link svg { height: 1.05rem; width: 1.05rem; }
  .footer-credits {
    align-items: center;
    color: rgb(148 163 184);
    display: flex;
    flex-wrap: wrap;
    font-family: Georgia, "Times New Roman", serif;
    font-size: 0.78rem;
    font-style: italic;
    gap: 0.8rem;
    letter-spacing: 0.02em;
  }
  .footer-copyright {
    align-items: center;
    display: inline-flex;
    gap: 0.35rem;
    transition: color 160ms ease;
  }
  .footer-copyright:hover { color: rgb(221 214 254); }
  .codex-link {
    align-items: center;
    color: rgb(196 181 253);
    display: inline-flex;
    gap: 0.35rem;
    padding: 0.2rem;
  }
  .codex-link svg { height: 1rem; width: 1rem; }
  @keyframes footer-arrival {
    from { opacity: 0; transform: translateY(0.75rem); }
    to { opacity: 0.8; transform: translateY(0); }
  }
  @media (max-width: 48rem) {
    .contact-footer { position: static; margin-top: 2rem; }
    .contact-footer-content { align-items: center; flex-direction: column; }
    .footer-credits { justify-content: center; text-align: center; }
  }
  @keyframes invalid-field {
    0%, 100% { box-shadow: 0 0 0 0 rgba(239, 68, 68, 0); }
    25% { border-color: rgb(254 202 202); box-shadow: 0 0 0 5px rgba(239, 68, 68, 0.34); }
    50% { border-color: rgb(220 38 38); box-shadow: 0 0 0 2px rgba(239, 68, 68, 0.12); }
    75% { border-color: rgb(254 202 202); box-shadow: 0 0 0 5px rgba(239, 68, 68, 0.34); }
  }
  @media (prefers-reduced-motion: reduce) {
    .contact-field.is-invalid input, .contact-field.is-invalid textarea, .contact-submit, .contact-footer { animation: none; transition: none; }
  }
</style>

<script>
  const contactForms = document.querySelectorAll<HTMLFormElement>("[data-contact-form]");

  contactForms.forEach((form) => {
    const status = form.querySelector<HTMLElement>("[data-contact-status]");
    const fields = Array.from(form.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>("input, textarea"));

    const clearInvalidState = (field: HTMLInputElement | HTMLTextAreaElement) => {
      if (field.validity.valid && field.value.trim()) field.closest(".contact-field")?.classList.remove("is-invalid");
    };

    fields.forEach((field) => {
      field.addEventListener("input", () => clearInvalidState(field));
      field.addEventListener("blur", () => clearInvalidState(field));
    });

    form.addEventListener("submit", (event) => {
      event.preventDefault();
      const invalidFields = fields.filter((field) => !field.value.trim() || !field.validity.valid);
      invalidFields.forEach((field) => field.closest(".contact-field")?.classList.add("is-invalid"));

      if (invalidFields.length > 0) {
        if (status) {
          status.textContent = "Please complete the highlighted fields before submitting.";
          status.className = "min-h-6 text-sm text-red-300";
        }
        invalidFields[0].focus();
        return;
      }

      const formData = new FormData(form);
      const name = String(formData.get("name") ?? "").trim();
      const email = String(formData.get("email") ?? "").trim();
      const message = String(formData.get("message") ?? "").trim();
      const subject = `Portfolio enquiry from ${name}`;
      const body = `Name: ${name}\nEmail: ${email}\n\nMessage:\n${message}`;
      window.location.href = `mailto:diegocarrillo.sa@gmail.com?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;

      if (status) {
        status.textContent = "Your email client is opening with your message prepared.";
        status.className = "min-h-6 text-sm text-violet-200";
      }
    });
  });
</script>
