---
import Container from "../common/Container.astro";
import Section from "../common/Section.astro";
import { aboutDestinations } from "../../data/about-destinations.ts";
import AboutDestinationIcon from "../common/AboutDestinationIcon.astro";
import ArrowIcon from "../common/ArrowIcon.astro";
import { getHomeContent, type Locale } from "../../i18n/home";

interface Props {
  locale?: Locale;
}

const { locale = "en" } = Astro.props;
const content = getHomeContent(locale).about;
const localePrefix = locale === "en" ? "" : `/${locale}`;
---

<Section
  id="about"
  class="relative isolate overflow-hidden bg-black"
>
  <Container>
    <div class="max-w-3xl">
      <p class="section-eyebrow text-violet-300">
        {content.eyebrow}
      </p>

      <h2 class="interactive-heading section-title mt-6 text-slate-400">
        {content.title}
      </h2>

      <p class="body-copy-reference mt-8 max-w-2xl text-slate-400">
        {content.paragraphs[0]}
      </p>

      <p class="body-copy-reference mt-5 max-w-2xl text-slate-400">
        {content.paragraphs[1]}
      </p>

      <div class="mt-10 flex w-full max-w-xl flex-col gap-3" aria-label={content.destinationsLabel}>
        {aboutDestinations.map((destination) => (
          <a
            href={`${localePrefix}/about/${destination.slug}/`}
            class="interactive-control neon-box-control premium-neon-control about-destination-control"
            aria-label={content.destinations[destination.slug]}
          >
            <span class="neon-box-symbol"><AboutDestinationIcon icon={destination.icon} /></span>
            <span class="neon-box-label">{content.destinations[destination.slug]}</span>
            <ArrowIcon />
          </a>
        ))}
      </div>

    </div>
  </Container>
</Section>
