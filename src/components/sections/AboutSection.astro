---
import Container from "../common/Container.astro";
import Section from "../common/Section.astro";
import { aboutDestinations } from "../../data/about-destinations.ts";
import AboutDestinationIcon from "../common/AboutDestinationIcon.astro";
---

<Section
  id="about"
  class="relative isolate overflow-hidden bg-black py-32 lg:py-40"
>
  <Container>
    <div class="max-w-3xl">
      <p class="text-sm font-medium tracking-[0.22em] text-violet-300">
        ABOUT
      </p>

      <h2 class="interactive-heading mt-6 text-4xl font-semibold tracking-tight text-slate-400 sm:text-5xl">
        Engineering systems that perform when complexity matters.
      </h2>

      <p class="mt-8 max-w-2xl text-lg leading-8 text-slate-400">
        I am Diego Carrillo S., a multidisciplinary systems engineer with an academic background in Electronic Engineering and an MSc in Robotics and Automation. My professional experience spans industrial control, renewable power, applied software and systems integration across Spain, the Netherlands, Portugal and Latin America, connecting automation, data and engineering to improve the reliability of complex infrastructure.
      </p>

      <div class="mt-10 flex w-full max-w-xl flex-col gap-3" aria-label="About sections">
        {aboutDestinations.map((destination) => (
          <a
            href={`/about/${destination.slug}/`}
            class="interactive-control neon-box-control premium-neon-control about-destination-control"
            aria-label={destination.label}
          >
            <span class="neon-box-symbol"><AboutDestinationIcon icon={destination.icon} /></span>
            <span class="neon-box-label">{destination.label}</span>
            <span class="neon-box-arrow" aria-hidden="true">↗</span>
          </a>
        ))}
      </div>

    </div>
  </Container>
</Section>
