---
interface Props {
  icon: "code" | "globe" | "academic" | "trophy";
}

const { icon } = Astro.props;
---

{icon === "code" && (
  <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round">
    <path d="m8.5 8-4 4 4 4" />
    <path d="m15.5 8 4 4-4 4" />
    <path d="m13.5 5-3 14" />
  </svg>
)}

{icon === "globe" && (
  <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round">
    <circle cx="12" cy="12" r="8.5" />
    <path d="M3.8 12h16.4" />
    <path d="M12 3.5c2.2 2.3 3.4 5.18 3.4 8.5S14.2 18.2 12 20.5C9.8 18.2 8.6 15.32 8.6 12S9.8 5.8 12 3.5Z" />
  </svg>
)}

{icon === "academic" && (
  <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round">
    <path d="m3 9 9-4.5L21 9l-9 4.5L3 9Z" />
    <path d="M6.5 10.75V15c2.85 2.2 8.15 2.2 11 0v-4.25" />
    <path d="M21 9v5.25" />
  </svg>
)}

{icon === "trophy" && (
  <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round">
    <path d="M8 4.5h8v4.75A4 4 0 0 1 12 13.25a4 4 0 0 1-4-4V4.5Z" />
    <path d="M8 6H5.5v1.5A3.5 3.5 0 0 0 9 11" />
    <path d="M16 6h2.5v1.5A3.5 3.5 0 0 1 15 11" />
    <path d="M12 13.25v3.25" />
    <path d="M8.5 19.5h7" />
    <path d="M10 16.5h4l1.5 3H8.5l1.5-3Z" />
  </svg>
)}
