---
interface Props {
  href: string;
  label: string;
}

const { href, label } = Astro.props;
---

<nav aria-label={label} class="floating-back-navigation" data-floating-back>
  <a href={href} class="interactive-control floating-back-control" aria-label={label} title={label}>
    <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.1" stroke-linecap="round" stroke-linejoin="round">
      <path d="M20 12H4" />
      <path d="m10 6-6 6 6 6" />
    </svg>
  </a>
</nav>

<script>
  if (document.querySelector("[data-floating-back]")) {
    let motionTimer: number | undefined;
    let visibilityTimer: number | undefined;

    const updateBackControl = () => {
      const isAtTop = window.scrollY <= 2;
      document.documentElement.classList.toggle("back-at-top", isAtTop);
      document.documentElement.classList.add("back-is-scrolling");
      window.clearTimeout(motionTimer);
      window.clearTimeout(visibilityTimer);
      motionTimer = window.setTimeout(() => document.documentElement.classList.remove("back-is-scrolling"), 150);

      if (isAtTop) {
        document.documentElement.classList.remove("back-show");
        return;
      }

      document.documentElement.classList.add("back-show");
      visibilityTimer = window.setTimeout(() => document.documentElement.classList.remove("back-show"), 1000);
    };

    document.documentElement.classList.toggle("back-at-top", window.scrollY <= 2);
    window.addEventListener("scroll", updateBackControl, { passive: true });
  }
</script>

<style>
  .floating-back-navigation {
    left: clamp(1.15rem, 3vw, 2.5rem);
    opacity: 0;
    pointer-events: none;
    position: fixed;
    top: 50%;
    transform: translateY(-50%);
    transition: opacity 420ms ease, visibility 420ms ease;
    visibility: hidden;
    width: fit-content;
    z-index: 45;
  }

  .floating-back-control {
    align-items: center;
    backdrop-filter: blur(12px);
    background: rgba(3, 3, 5, 0.72);
    border: 1px solid rgba(196, 181, 253, 0.3);
    border-radius: 999px;
    color: rgb(148 163 184);
    display: inline-flex;
    height: 3rem;
    justify-content: center;
    padding: 0.35rem;
    width: 3rem;
  }

  .floating-back-control svg {
    height: 1.7rem;
    min-height: 1.7rem;
    min-width: 1.7rem;
    transition: filter 180ms ease, transform 180ms ease;
    width: 1.7rem;
  }

  :global(html.back-at-top) .floating-back-navigation,
  :global(html.back-show) .floating-back-navigation {
    opacity: 1;
    pointer-events: auto;
    visibility: visible;
  }

  :global(html.back-is-scrolling) .floating-back-control {
    animation: floating-back-scroll 900ms ease-in-out infinite;
    border-color: rgb(196 181 253);
    box-shadow: 0 0 0.7rem rgba(139, 92, 246, 0.22);
  }

  :global(html.back-is-scrolling) .floating-back-control svg {
    animation: floating-arrow-scroll 900ms ease-in-out infinite;
  }

  .interactive-control.floating-back-control:hover,
  .interactive-control.floating-back-control:focus-visible {
    background: rgba(3, 3, 5, 0.82);
    border-color: rgb(196 181 253);
    box-shadow: 0 0 0.8rem rgba(139, 92, 246, 0.2);
    color: rgb(196 181 253);
    transform: none;
  }

  .interactive-control.floating-back-control:hover svg,
  .interactive-control.floating-back-control:focus-visible svg {
    filter: drop-shadow(0 0 5px rgba(167, 139, 250, 0.5));
    transform: translateX(-0.12rem);
  }

  @keyframes floating-back-scroll {
    0%, 100% { border-color: rgba(139, 92, 246, 0.35); transform: translateY(0); }
    50% { border-color: rgba(237, 233, 254, 0.95); transform: translateY(-0.22rem); }
  }

  @keyframes floating-arrow-scroll {
    0%, 100% { transform: translateX(0); }
    50% { transform: translateX(-0.18rem); }
  }

  @media (max-width: 640px) {
    :global(html.back-at-top) .floating-back-navigation {
      left: 1.35rem;
      top: calc(6.25rem + env(safe-area-inset-top));
      transform: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    :global(html.back-is-scrolling) .floating-back-control,
    :global(html.back-is-scrolling) .floating-back-control svg { animation: none; }
  }
</style>
