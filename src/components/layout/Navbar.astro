---
import Container from "../common/Container.astro";
---

<header class="sticky top-0 z-50 border-b border-white/5 bg-black/20 backdrop-blur-xl">

  <Container>

    <nav class="flex h-20 items-center gap-4">

      <a
        href="/"
        class="shrink-0 text-lg font-semibold tracking-wide text-white"
      >
        DC
      </a>

      <ul class="flex min-w-0 flex-1 justify-end gap-4 overflow-x-auto whitespace-nowrap px-1 text-xs text-slate-300 [scrollbar-width:none] [&::-webkit-scrollbar]:hidden sm:gap-6 sm:text-sm">

        <li><a class="interactive-control nav-control" href="#about">About</a></li>

        <li><a class="interactive-control nav-control" href="#experience">Experience</a></li>

        <li><a class="interactive-control nav-control" href="#projects">Projects</a></li>

        <li><a class="interactive-control nav-control" href="#perspective">International</a></li>

        <li><a class="interactive-control nav-control" href="#research">Research</a></li>

        <li><a class="interactive-control nav-control" href="#contact">Contact</a></li>

      </ul>

    </nav>

  </Container>

</header>
