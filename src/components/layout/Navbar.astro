---
import Container from "../common/Container.astro";
import HomeIcon from "../common/HomeIcon.astro";
import type { Locale } from "../../i18n/home";

interface Props {
  locale?: Locale;
}

const { locale = "en" } = Astro.props;
const isFrench = locale === "fr";
const isDutch = locale === "nl";
const isGerman = locale === "de";
const homePath = locale === "en" ? "/" : `/${locale}/`;
const isHome = Astro.url.pathname === homePath || (locale !== "en" && Astro.url.pathname === `/${locale}`);
const sectionHref = (section: string) => (isHome ? `#${section}` : `${homePath}#${section}`);
const unprefixedPath = Astro.url.pathname.replace(/^\/(nl|de|fr)(?=\/|$)/, "") || "/";
const englishPath = locale === "en" ? Astro.url.pathname : unprefixedPath;
const dutchPath = isDutch ? Astro.url.pathname : `/nl${unprefixedPath}`;
const germanPath = isGerman ? Astro.url.pathname : `/de${unprefixedPath}`;
const frenchPath = isFrench ? Astro.url.pathname : `/fr${unprefixedPath}`;
const labels = isFrench
  ? { about: "À propos", projects: "Projets", milestones: "Temps forts", faq: "FAQ", contact: "Contact" }
  : isGerman
  ? { about: "Über mich", projects: "Projekte", milestones: "Meilensteine", faq: "FAQ", contact: "Kontakt" }
  : isDutch
  ? { about: "Over mij", projects: "Projecten", milestones: "Mijlpalen", faq: "FAQ", contact: "Contact" }
  : { about: "About", projects: "Projects", milestones: "Milestones", faq: "FAQ", contact: "Contact" };
const ui = isFrench
  ? { home: "Revenir à la présentation", chooseLanguage: "Choisir la langue", languages: "Langues disponibles", openMenu: "Ouvrir le menu de navigation", mainNavigation: "Navigation principale", light: "Passer au thème clair", dark: "Passer au thème sombre", lightTitle: "Thème clair", darkTitle: "Thème sombre" }
  : isGerman
  ? { home: "Zur Einführung", chooseLanguage: "Anzeigesprache auswählen", languages: "Verfügbare Sprachen", openMenu: "Navigationsmenü öffnen", mainNavigation: "Hauptnavigation", light: "Zum hellen Modus wechseln", dark: "Zum dunklen Modus wechseln", lightTitle: "Heller Modus", darkTitle: "Dunkler Modus" }
  : isDutch
  ? { home: "Ga naar de introductie", chooseLanguage: "Taal selecteren", languages: "Beschikbare talen", openMenu: "Navigatiemenu openen", mainNavigation: "Hoofdnavigatie", light: "Overschakelen naar lichte modus", dark: "Overschakelen naar donkere modus", lightTitle: "Lichte modus", darkTitle: "Donkere modus" }
  : { home: "Go to the main introduction", chooseLanguage: "Choose display language", languages: "Available languages", openMenu: "Open navigation menu", mainNavigation: "Main navigation", light: "Switch to light mode", dark: "Switch to dark mode", lightTitle: "Light mode", darkTitle: "Dark mode" };
---

<header class="site-header sticky top-0 z-50">
  <Container>
    <nav class="flex h-20 items-center gap-3 sm:gap-5">
      <div class="header-actions shrink-0">
        <a href={sectionHref("about")} class="interactive-control home-control" aria-label={ui.home} title={labels.about}><HomeIcon /></a>

        <button class="interactive-control theme-control" type="button" data-theme-toggle data-light-label={ui.light} data-dark-label={ui.dark} data-light-title={ui.lightTitle} data-dark-title={ui.darkTitle} aria-label={ui.light} title={ui.lightTitle}>
          <svg class="theme-icon theme-icon-moon" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.65" stroke-linecap="round" stroke-linejoin="round" shape-rendering="geometricPrecision"><path d="M20.4 15.2A8.7 8.7 0 0 1 8.8 3.6 8.8 8.8 0 1 0 20.4 15.2Z"></path></svg>
          <svg class="theme-icon theme-icon-sun" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.65" stroke-linecap="round" stroke-linejoin="round" shape-rendering="geometricPrecision"><circle cx="12" cy="12" r="3.6"></circle><path d="M12 2v2M12 20v2M4.93 4.93l1.42 1.42M17.65 17.65l1.42 1.42M2 12h2M20 12h2M4.93 19.07l1.42-1.42M17.65 6.35l1.42-1.42"></path></svg>
        </button>

        <details class="language-selector" data-language-selector>
          <summary class="interactive-control language-trigger" aria-label={ui.chooseLanguage}>
            <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.65" stroke-linecap="round" stroke-linejoin="round" shape-rendering="geometricPrecision"><circle cx="12" cy="12" r="9"></circle><path d="M3.5 9h17M3.5 15h17M12 3c2.1 2.35 3.2 5.35 3.2 9S14.1 18.65 12 21M12 3C9.9 5.35 8.8 8.35 8.8 12S9.9 18.65 12 21"></path></svg>
            <span data-language-code>{locale.toUpperCase()}</span>
            <svg class="language-chevron" aria-hidden="true" viewBox="0 0 12 8" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="m1 1.5 5 5 5-5"></path></svg>
          </summary>
          <div class="language-menu" role="menu" aria-label={ui.languages}>
            <button type="button" role="menuitemradio" aria-label={isFrench ? "Anglais" : isGerman ? "Englisch" : isDutch ? "Engels" : "English"} aria-checked={String(locale === "en")} data-language-option data-code="EN" data-href={englishPath}><svg class="language-flag" aria-hidden="true" viewBox="0 0 26 16"><rect width="26" height="16" fill="#fff"/><path fill="#b22234" d="M0 0h26v2H0zm0 4h26v2H0zm0 4h26v2H0zm0 4h26v2H0z"/><rect width="11" height="8" fill="#3c3b6e"/><g fill="#fff"><circle cx="2" cy="2" r=".55"/><circle cx="5.5" cy="2" r=".55"/><circle cx="9" cy="2" r=".55"/><circle cx="3.75" cy="4" r=".55"/><circle cx="7.25" cy="4" r=".55"/><circle cx="2" cy="6" r=".55"/><circle cx="5.5" cy="6" r=".55"/><circle cx="9" cy="6" r=".55"/></g></svg><span>EN</span></button>
            <button type="button" role="menuitemradio" aria-label={isFrench ? "Allemand" : isGerman ? "Deutsch" : isDutch ? "Duits" : "German"} aria-checked={String(locale === "de")} data-language-option data-code="DE" data-href={germanPath}><svg class="language-flag" aria-hidden="true" viewBox="0 0 15 9"><path fill="#000" d="M0 0h15v3H0z"/><path fill="#dd0000" d="M0 3h15v3H0z"/><path fill="#ffce00" d="M0 6h15v3H0z"/></svg><span>DE</span></button>
            <button type="button" role="menuitemradio" aria-label={isFrench ? "Néerlandais" : isGerman ? "Niederländisch" : isDutch ? "Nederlands" : "Dutch"} aria-checked={String(locale === "nl")} data-language-option data-code="NL" data-href={dutchPath}><svg class="language-flag" aria-hidden="true" viewBox="0 0 15 9"><path fill="#ae1c28" d="M0 0h15v3H0z"/><path fill="#fff" d="M0 3h15v3H0z"/><path fill="#21468b" d="M0 6h15v3H0z"/></svg><span>NL</span></button>
            <button type="button" role="menuitemradio" aria-label={isFrench ? "Français" : isGerman ? "Französisch" : isDutch ? "Frans" : "French"} aria-checked={String(locale === "fr")} data-language-option data-code="FR" data-href={frenchPath}><svg class="language-flag" aria-hidden="true" viewBox="0 0 15 9"><path fill="#0055a4" d="M0 0h5v9H0z"/><path fill="#fff" d="M5 0h5v9H5z"/><path fill="#ef4135" d="M10 0h5v9h-5z"/></svg><span>FR</span></button>
          </div>
        </details>
      </div>

      <ul class="desktop-navigation min-w-0 flex-1 justify-end gap-2 overflow-x-auto whitespace-nowrap px-3 py-3 [scrollbar-width:none] [&::-webkit-scrollbar]:hidden sm:gap-3">
        <li><a class="interactive-control nav-control" href={sectionHref("about")} data-nav-link="about">{labels.about}</a></li>
        <li><a class="interactive-control nav-control" href={sectionHref("projects")} data-nav-link="projects">{labels.projects}</a></li>
        <li><a class="interactive-control nav-control" href={sectionHref("milestones")} data-nav-link="milestones">{labels.milestones}</a></li>
        <li><a class="interactive-control nav-control" href={sectionHref("faq")} data-nav-link="faq">{labels.faq}</a></li>
        <li><a class="interactive-control nav-control" href={sectionHref("contact")} data-nav-link="contact">{labels.contact}</a></li>
      </ul>

      <details class="mobile-navigation" data-mobile-navigation>
        <summary class="interactive-control mobile-menu-trigger" aria-label={ui.openMenu}><span></span><span></span><span></span></summary>
        <div class="mobile-menu" role="menu" aria-label={ui.mainNavigation}>
          <a role="menuitem" href={sectionHref("about")} data-nav-link="about">{labels.about}</a>
          <a role="menuitem" href={sectionHref("projects")} data-nav-link="projects">{labels.projects}</a>
          <a role="menuitem" href={sectionHref("milestones")} data-nav-link="milestones">{labels.milestones}</a>
          <a role="menuitem" href={sectionHref("faq")} data-nav-link="faq">{labels.faq}</a>
          <a role="menuitem" href={sectionHref("contact")} data-nav-link="contact">{labels.contact}</a>
        </div>
      </details>
    </nav>
  </Container>
</header>

<script>
  const isIPad = /iPad/i.test(navigator.userAgent)
    || (navigator.platform === "MacIntel" && navigator.maxTouchPoints > 1);
  if (isIPad) document.documentElement.classList.add("ipad-navigation");

  const themeToggles = document.querySelectorAll<HTMLButtonElement>("[data-theme-toggle]");
  const syncThemeControls = () => {
    const isLight = document.documentElement.dataset.theme === "light";
    themeToggles.forEach((toggle) => {
      toggle.setAttribute("aria-label", isLight ? (toggle.dataset.darkLabel ?? "Switch to dark mode") : (toggle.dataset.lightLabel ?? "Switch to light mode"));
      toggle.title = isLight ? (toggle.dataset.darkTitle ?? "Dark mode") : (toggle.dataset.lightTitle ?? "Light mode");
    });
  };

  themeToggles.forEach((toggle) => toggle.addEventListener("click", () => {
    const nextTheme = document.documentElement.dataset.theme === "light" ? "dark" : "light";
    document.documentElement.dataset.theme = nextTheme;
    try { sessionStorage.setItem("portfolio-theme", nextTheme); } catch {}
    syncThemeControls();
  }));
  syncThemeControls();

  const closeOnEscape = (element: HTMLDetailsElement) => element.addEventListener("keydown", (event) => {
    if (event.key === "Escape") { element.removeAttribute("open"); element.querySelector<HTMLElement>("summary")?.focus(); }
  });
  const languageSelectors = document.querySelectorAll<HTMLDetailsElement>("[data-language-selector]");
  const mobileMenus = document.querySelectorAll<HTMLDetailsElement>("[data-mobile-navigation]");

  languageSelectors.forEach((selector) => {
    const code = selector.querySelector<HTMLElement>("[data-language-code]");
    const options = selector.querySelectorAll<HTMLButtonElement>("[data-language-option]");
    options.forEach((option) => option.addEventListener("click", () => {
      const target = option.dataset.href;
      if (target) {
        const hash = window.location.hash;
        window.location.href = `${target}${hash}`;
        return;
      }
      if (code) code.textContent = option.dataset.code ?? "EN";
      options.forEach((item) => item.setAttribute("aria-checked", String(item === option)));
      selector.removeAttribute("open");
    }));
    closeOnEscape(selector);
  });

  mobileMenus.forEach((menu) => {
    menu.querySelectorAll<HTMLAnchorElement>("a").forEach((link) => {
      link.addEventListener("pointerdown", () => {
        link.classList.remove("is-tap-confirmed");
        requestAnimationFrame(() => link.classList.add("is-tap-confirmed"));
      });
      link.addEventListener("animationend", () => link.classList.remove("is-tap-confirmed"));
      link.addEventListener("click", () => menu.removeAttribute("open"));
    });
    closeOnEscape(menu);
  });

  document.addEventListener("pointerdown", (event) => {
    [...languageSelectors, ...mobileMenus].forEach((element) => {
      if (!element.contains(event.target as Node)) element.removeAttribute("open");
    });
  });
</script>

<style>
  .header-actions { align-items: center; display: flex; gap: 0.55rem; }
  .header-actions svg { shape-rendering: geometricPrecision; }
  .theme-control { align-items: center; background: transparent; border: .75px solid rgba(196,181,253,.52); border-radius: 999px; box-shadow: none; color: rgb(203 213 225); cursor: pointer; display: inline-flex; height: 2.5rem; justify-content: center; padding: 0; width: 2.5rem; }
  .theme-icon { height: 1.1rem; width: 1.1rem; }
  .theme-icon-sun { display: none; }
  :global(html[data-theme="light"]) .theme-icon-moon { display: none; }
  :global(html[data-theme="light"]) .theme-icon-sun { display: block; }
  .language-selector, .mobile-navigation { position: relative; }
  .language-trigger { align-items: center; border: .75px solid rgba(196,181,253,.52); border-radius: 999px; box-shadow: none; color: rgb(203 213 225); cursor: pointer; display: inline-flex; gap: .35rem; height: 2.5rem; justify-content: center; list-style: none; padding: .35rem .6rem; }
  .language-trigger::-webkit-details-marker, .mobile-menu-trigger::-webkit-details-marker { display: none; }
  .language-trigger > svg:first-child { height: 1.1rem; width: 1.1rem; }
  .language-trigger > span { font-size: var(--type-micro-size); font-weight: 700; letter-spacing: .12em; }
  .language-chevron { height: .45rem; transition: transform 180ms ease; width: .65rem; }
  .language-selector[open] .language-chevron { transform: rotate(180deg); }
  .language-trigger:hover, .language-trigger:focus-visible, .language-selector[open] .language-trigger,
  .mobile-menu-trigger:hover, .mobile-menu-trigger:focus-visible, .mobile-navigation[open] .mobile-menu-trigger { border-color: rgb(196 181 253); color: rgb(196 181 253); }

  .language-menu, .mobile-menu { background: rgba(5,5,9,.98); border: 1px solid rgba(196,181,253,.28); border-radius: .8rem; box-shadow: 0 16px 36px rgba(0,0,0,.48); min-width: 11rem; padding: .35rem; position: absolute; top: calc(100% + .55rem); }
  .language-menu { left: 0; min-width: 5.6rem; }
  .mobile-menu { right: 0; }
  .language-menu button { align-items: center; border-radius: .55rem; color: rgb(203 213 225); cursor: pointer; display: grid; font-size: var(--type-caption-size); font-weight: 700; gap: .55rem; grid-template-columns: 1.35rem 1fr; letter-spacing: .12em; padding: .62rem .7rem; text-align: left; width: 100%; }
  .language-menu button:hover, .language-menu button:focus-visible, .mobile-menu a:hover, .mobile-menu a:focus-visible { background: rgba(167,139,250,.1); color: rgb(245 243 255); outline: none; }
  .language-menu button[aria-checked="true"] { color: rgb(196 181 253); }
  .desktop-navigation { display: flex; }
  .desktop-navigation .nav-control { color: rgb(196 181 253); font-size: var(--type-ui-size); font-weight: 600; letter-spacing: .08em; line-height: var(--type-ui-line-height); text-transform: uppercase; }

  .language-flag { border-radius: .08rem; display: block; height: .78rem; overflow: hidden; shape-rendering: crispEdges; width: 1.22rem; }

  .mobile-navigation { display: none; margin-left: auto; }
  :global(html.ipad-navigation) .desktop-navigation { display: none !important; }
  :global(html.ipad-navigation) .mobile-navigation { display: block !important; }
  .mobile-menu-trigger { align-content: center; border: .75px solid rgba(196,181,253,.52); border-radius: 999px; box-shadow: none; color: rgb(203 213 225); cursor: pointer; display: grid; gap: .24rem; height: 2.5rem; justify-content: center; list-style: none; padding: 0; width: 2.5rem; }
  .mobile-menu-trigger span { background: currentColor; border-radius: 999px; height: 1px; transform: translateZ(0); transition: transform 180ms ease, opacity 180ms ease; width: 1.05rem; }
  .mobile-navigation[open] .mobile-menu-trigger span:nth-child(1) { transform: translateY(.29rem) rotate(45deg); }
  .mobile-navigation[open] .mobile-menu-trigger span:nth-child(2) { opacity: 0; }
  .mobile-navigation[open] .mobile-menu-trigger span:nth-child(3) { transform: translateY(-.29rem) rotate(-45deg); }
  .mobile-menu a { border-radius: .55rem; color: rgb(196 181 253); display: block; font-size: var(--type-ui-size); font-weight: 650; letter-spacing: .12em; line-height: var(--type-ui-line-height); overflow: hidden; padding: .72rem .8rem; position: relative; text-transform: uppercase; transition: background-color 180ms ease, color 180ms ease, transform 180ms ease; }
  .mobile-menu a::after { background: linear-gradient(90deg,transparent,rgb(139 92 246),rgb(196 181 253),transparent); bottom: .35rem; content: ""; height: 1px; left: .8rem; opacity: 0; position: absolute; right: .8rem; transform: scaleX(.18); transition: opacity 180ms ease,transform 380ms cubic-bezier(.22,1,.36,1); }
  .mobile-menu a:hover::after, .mobile-menu a:focus-visible::after, .mobile-menu a.is-tap-confirmed::after { opacity: 1; transform: scaleX(1); }

  @keyframes mobile-nav-confirm {
    0% { background: transparent; transform: translateY(0); }
    46% { background: rgba(167,139,250,.08); transform: translateY(-2px); }
    100% { background: transparent; transform: translateY(0); }
  }

  @media (max-width: 1366px) {
    .desktop-navigation { display: none !important; }
    .mobile-navigation { display: block !important; }
    .mobile-navigation[open] .mobile-menu-trigger { animation: none; background: rgb(196 181 253); border-color: rgb(196 181 253); color: rgb(5 5 9); }
    .mobile-navigation[open] .mobile-menu { animation: none; }
    .mobile-menu a.is-tap-confirmed { animation: mobile-nav-confirm 360ms cubic-bezier(.22,1,.36,1); }
  }

  @media (min-width: 640px) and (max-width: 1366px) {
    .mobile-menu { min-width: 15rem; padding: .55rem; }
    .mobile-menu a { padding: .8rem; }
  }

  @media (hover: none) and (pointer: coarse) {
    .desktop-navigation { display: none !important; }
    .mobile-navigation { display: block !important; }
  }

  @media (max-width: 639px) {
    .language-trigger > svg:first-child { height: 1.1rem; width: 1.1rem; }
    .language-menu { min-width: 5.6rem; }
    .mobile-menu { min-width: 10.5rem; }
  }

  @media (prefers-reduced-motion: reduce) {
    .mobile-menu a { transition: none; }
    .mobile-menu a.is-tap-confirmed { animation: none; background: rgb(196 181 253); color: rgb(5 5 9); }
    .mobile-navigation[open] .mobile-menu { animation: none; }
  }
</style>
