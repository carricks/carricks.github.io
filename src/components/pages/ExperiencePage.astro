---
import BaseLayout from "../../layouts/BaseLayout.astro";
import FloatingBackControl from "../common/FloatingBackControl.astro";
import { imageLibrary } from "../../data/image-library";
import { descriptionsFr, experienceFr } from "../../i18n/pages.fr";
import type { Locale } from "../../i18n/home";

interface Props { locale: Locale }
const { locale } = Astro.props;
const isDutch = locale === "nl";
const isGerman = locale === "de";
const homePath = locale === "en" ? "/" : `/${locale}/`;

const experiencesEn = [
  {
    company: "Capgemini",
    country: "The Netherlands",
    logo: imageLibrary.logos.capgemini.dark.desktop,
    logoId: "capgemini",
    logoViewBox: "0 0 2081 462",
    logoClass: "experience-company-logo--capgemini",
    description: "I develop and validate applications for the Dutch transmission grid. They turn operational data into large-scale simulations and structured results for power system stability analysis. The work combines software engineering, data processing and close collaboration with domain specialists.",
  },
  {
    company: "AspenTech",
    country: "Spain",
    logo: imageLibrary.logos.aspentech.dark.desktop,
    logoId: "aspentech",
    logoViewBox: "0 0 1800 362",
    logoClass: "experience-company-logo--aspentech",
    description: "I worked on SCADA design, deployment on Linux and Windows, and secure integration for offshore energy operations. I helped connect segregated environments while protecting critical control networks, supporting architecture, configuration, testing and delivery.",
  },
  {
    company: "Isemaren",
    country: "Spain",
    logo: imageLibrary.logos.isemaren.dark.desktop,
    logoId: "isemaren",
    logoViewBox: "0 0 2171 246",
    logoClass: "experience-company-logo--isemaren",
    description: "I supported the deployment and commissioning of PLC-based Power Plant Controllers for solar plants up to 380 MW. The work integrated HMI, SCADA and communications, using structured tests and troubleshooting to check compliance with grid requirements.",
  },
  {
    company: "Universidad Carlos III de Madrid",
    country: "Spain",
    logo: imageLibrary.logos.uc3m.dark.desktop,
    logoId: "uc3m",
    logoViewBox: "0 0 598 182",
    description: "Within the Social Robotics Group, I helped develop web services, user and licensing systems, databases and Linux server infrastructure for an assistive robotics platform. I helped turn research requirements into maintainable services connecting people and robots.",
  },
  {
    company: "Boston Scientific",
    country: "International",
    logo: imageLibrary.logos.bostonScientific.dark.desktop,
    logoId: "boston-scientific",
    logoViewBox: "0 0 126 62",
    logoClass: "experience-company-logo--boston",
    description: "I supported regulated medical device manufacturing by maintaining measurement accuracy and compliance and contributing to PLC-based test and calibration systems. The work required reliable measurements, controlled processes and clear technical documentation to support production continuity.",
  },
  {
    company: "Xacom Communications",
    country: "Spain",
    logo: imageLibrary.logos.xacom.dark.desktop,
    logoId: "xacom",
    logoViewBox: "0 0 100 112",
    logoClass: "experience-company-logo--xacom",
    description: "I designed and deployed mobile coverage for industrial, underground and remote sites. The work combined RF systems, network infrastructure, measurements, commissioning and field troubleshooting across several generations of mobile technology.",
  },
] as const;

const descriptionsNl = [
  "Ik ontwikkel en valideer applicaties voor het Nederlandse transmissienet. Ze zetten operationele data om in grootschalige simulaties en gestructureerde resultaten voor netstabiliteitsanalyse. Het werk combineert softwareontwikkeling, dataverwerking en nauwe samenwerking met vakspecialisten. DSA ondersteunt daarbij de beoordeling van de dynamische netveiligheid.",
  "Ik werkte aan SCADA-ontwerp, implementaties op Linux en Windows en veilige integratie voor offshore-energieactiviteiten. Ik hielp gescheiden omgevingen te verbinden met behoud van kritieke besturingsnetwerken, van architectuur en configuratie tot testen en oplevering.",
  "Ik ondersteunde de uitrol en inbedrijfstelling van Power Plant Controllers op PLC-basis voor zonnecentrales tot 380 MW. HMI, SCADA en communicatie werden geïntegreerd. Gestructureerde tests en probleemoplossing toetsten het gedrag aan de netvereisten.",
  "Binnen de Social Robotics Group ontwikkelde ik webservices, gebruikers- en licentiesystemen, databases en Linux-serverinfrastructuur voor een platform voor ondersteunende robotica. Ik hielp onderzoekseisen om te zetten in onderhoudbare diensten voor interactie tussen mensen en robots.",
  "Ik ondersteunde de gereguleerde productie van medische hulpmiddelen door meetnauwkeurigheid en naleving van voorschriften te bewaken en bij te dragen aan PLC-gebaseerde test- en kalibratiesystemen. Betrouwbare metingen, beheerste processen en duidelijke documentatie ondersteunden de productiecontinuïteit.",
  "Ik ontwierp en realiseerde mobiele dekking voor industriële, ondergrondse en afgelegen locaties. Het werk combineerde RF-systemen, netwerkinfrastructuur, metingen, inbedrijfstelling en probleemoplossing op locatie voor meerdere generaties mobiele technologie."
] as const;

const descriptionsDe = [
  "Ich entwickle und validiere Anwendungen für das niederländische Übertragungsnetz. Sie wandeln Betriebsdaten in groß angelegte Simulationen und strukturierte Ergebnisse zur Netzstabilität um. Die Arbeit verbindet Softwareentwicklung, Datenverarbeitung und enge Zusammenarbeit mit Fachkräften. DSA unterstützt dabei die Bewertung der dynamischen Netzsicherheit.",
  "Ich arbeitete an SCADA-Entwurf, Bereitstellung unter Linux und Windows sowie sicherer Integration für Offshore-Energieanlagen. Ich half, getrennte Umgebungen unter Schutz kritischer Steuerungsnetze zu verbinden, von Architektur und Konfiguration bis zu Tests und Umsetzung.",
  "Ich unterstützte die Bereitstellung und Inbetriebnahme von Power Plant Controllern auf SPS-Basis für Solaranlagen bis 380 MW. Die Arbeit integrierte HMI, SCADA und Kommunikation. Strukturierte Tests und Fehlerbehebung prüften das Verhalten anhand der Netzanforderungen.",
  "In der Social Robotics Group entwickelte ich Webdienste, Benutzer- und Lizenzsysteme, Datenbanken und Linux-Serverinfrastruktur für eine Plattform der Assistenzrobotik. Ich half, Forschungsanforderungen in wartbare Dienste für die Interaktion zwischen Menschen und Robotern zu überführen.",
  "Ich unterstützte die regulierte Fertigung von Medizinprodukten durch genaue und vorschriftskonforme Messmittel sowie Beiträge zu SPS-basierten Test- und Kalibriersystemen. Zuverlässige Messungen, kontrollierte Prozesse und klare Dokumentation unterstützten den laufenden Produktionsbetrieb.",
  "Ich plante und realisierte Mobilfunkabdeckung für industrielle, unterirdische und abgelegene Standorte. Die Arbeit verband Hochfrequenzsysteme, Netzwerktechnik, Messungen, Inbetriebnahme und Fehlerbehebung vor Ort für mehrere Mobilfunkgenerationen."
] as const;

const experiences = experiencesEn.map((experience, index) => ({
  ...experience,
  country: locale === "fr" ? ({ "The Netherlands": "Pays-Bas", Spain: "Espagne", International: "International" }[experience.country] ?? experience.country) : isGerman ? ({ "The Netherlands": "Niederlande", Spain: "Spanien", International: "International" }[experience.country] ?? experience.country) : isDutch ? ({ "The Netherlands": "Nederland", Spain: "Spanje", International: "Internationaal" }[experience.country] ?? experience.country) : experience.country,
  description: locale === "fr" ? descriptionsFr[index] : isGerman ? descriptionsDe[index] : isDutch ? descriptionsNl[index] : experience.description,
}));

const copy = locale === "fr" ? experienceFr : isGerman ? {
  title: "Berufserfahrung | Diego Carrillo",
  description: "Ausgewählte Ingenieurerfahrung in resilienten Energiesystemen, sicherer industrieller Integration und der Regelung erneuerbarer Anlagen.",
  back: "Zurück zu Über mich", eyebrow: "BERUFSERFAHRUNG", heading: "Engineering für kritische Systeme.",
  intro: "Mein Berufsweg umfasst verschiedene Branchen und technische Umgebungen. Heute arbeite ich in Nordwesteuropa und baue auf Erfahrungen aus Südeuropa und Lateinamerika auf.",
} : isDutch ? {
  title: "Ervaring | Diego Carrillo",
  description: "Geselecteerde engineeringervaring in robuuste energiesystemen, veilige industriële integratie en de besturing van hernieuwbare installaties.",
  back: "Terug naar Over mij", eyebrow: "ERVARING", heading: "Engineering voor kritieke systemen.",
  intro: "Mijn loopbaan omvat verschillende sectoren en technische omgevingen. Vanuit Noordwest-Europa bouw ik verder op ervaring uit Zuid-Europa en Latijns-Amerika.",
} : {
  title: "Experience | Diego Carrillo", description: "Selected engineering experience across resilient power systems, secure industrial integration and renewable plant control.",
  back: "Back to about", eyebrow: "EXPERIENCE", heading: "Engineering in critical systems.",
  intro: "My career spans several industries and technical environments. I now work in Northwestern Europe, building on experience gained in Mediterranean Europe and Latin America.",
};
---

<BaseLayout locale={locale} title={copy.title} description={copy.description}>
  <section class="relative isolate overflow-hidden px-6 py-8 sm:px-10 lg:px-16">
    <FloatingBackControl href={`${homePath}#about`} label={copy.back} />

    <article class="mx-auto mt-12 max-w-5xl pb-12 sm:mt-14 sm:pb-14">
      <p class="section-eyebrow text-violet-300">{copy.eyebrow}</p>
      <h1 class="interactive-heading page-title mt-5 max-w-3xl text-slate-400">{copy.heading}</h1>
      <p class="body-copy-reference mt-7 max-w-3xl text-slate-300">{copy.intro}</p>

      <div class="experience-modules mt-16 grid gap-5">
        {experiences.map((experience) => (
          <section class="experience-module neon-box-panel">
            <div class="experience-heading">
              <div class="experience-company">
                {"logo" in experience ? (
                  <svg
                    class:list={["experience-company-logo", "logoClass" in experience && experience.logoClass]}
                    viewBox={experience.logoViewBox}
                    role="img"
                    aria-label={experience.company}
                    preserveAspectRatio="xMinYMid meet"
                  >
                    <defs>
                      <filter id={`experience-logo-${experience.logoId}`} x="0" y="0" width="100%" height="100%" color-interpolation-filters="sRGB">
                        <feFlood class="experience-company-logo-colour" flood-color="rgb(196 181 253)" result="logo-colour" />
                        <feComposite in="logo-colour" in2="SourceAlpha" operator="in" />
                      </filter>
                    </defs>
                    <image
                      href={experience.logo}
                      x="0"
                      y="0"
                      width="100%"
                      height="100%"
                      preserveAspectRatio="xMinYMid meet"
                      filter={`url(#experience-logo-${experience.logoId})`}
                    />
                  </svg>
                ) : (
                  <h2>{experience.company}</h2>
                )}
              </div>
              {"country" in experience && <p>{experience.country}</p>}
            </div>
            <p class="experience-description">{experience.description}</p>
          </section>
        ))}
      </div>
    </article>
  </section>
</BaseLayout>

<style>
  .experience-modules { max-width: 52rem; }
  .experience-module { background: rgba(3,3,5,.57); padding: clamp(1.35rem, 3vw, 2rem); }
  .experience-heading { align-items: center; display: flex; gap: 1rem; justify-content: space-between; }
  .experience-company { align-items: center; display: flex; gap: .8rem; min-height: 2.25rem; min-width: 0; }
  .experience-heading h2 { color: rgb(196 181 253); font-size: var(--type-card-title-size); font-weight: 600; letter-spacing: -.01em; line-height: var(--type-card-title-line-height); }
  .experience-company-logo { color: rgb(196 181 253); display: block; height: 1.15rem; width: 3.78rem; }
  .experience-company-logo-colour { flood-color: rgb(196 181 253); }
  .experience-company-logo--capgemini { height: 1.5rem; width: 6.76rem; }
  .experience-company-logo--aspentech { height: 1.5rem; width: 7.46rem; }
  .experience-company-logo--isemaren { height: .8rem; width: 7rem; }
  .experience-company-logo--boston { height: 1.97rem; width: 4rem; }
  .experience-company-logo--xacom { height: 1.96rem; width: 1.75rem; }
  .experience-heading p { color: rgb(196 181 253); flex: 0 0 auto; font-size: var(--type-caption-size); font-weight: 600; letter-spacing: var(--type-label-letter-spacing); line-height: var(--type-caption-line-height); text-transform: uppercase; }
  .experience-description { color: rgb(148 163 184); font-family: var(--font-sans); font-size: var(--type-body-size); font-weight: var(--type-body-weight); letter-spacing: var(--type-body-letter-spacing); line-height: var(--type-body-line-height); margin-top: .85rem; }

  @media (max-width: 48rem) {
    .experience-module { padding: 1.35rem; }
    .experience-heading { align-items: center; flex-direction: row; gap: 1rem; }
    .experience-company { gap: .65rem; min-height: 2rem; }
    .experience-company-logo { height: 1.05rem; width: 3.45rem; }
    .experience-company-logo--capgemini { height: 1.35rem; width: 6.08rem; }
    .experience-company-logo--aspentech { height: 1.35rem; width: 6.71rem; }
    .experience-company-logo--isemaren { height: .71rem; width: 6.25rem; }
    .experience-company-logo--boston { height: 1.85rem; width: 3.75rem; }
    .experience-company-logo--xacom { height: 1.79rem; width: 1.6rem; }
  }
</style>
