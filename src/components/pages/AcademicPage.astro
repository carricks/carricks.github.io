---
import BaseLayout from "../../layouts/BaseLayout.astro";
import FloatingBackControl from "../common/FloatingBackControl.astro";
import type { Locale } from "../../i18n/home";

interface Props { locale: Locale }
const { locale } = Astro.props;
const homePath = locale === "en" ? "/" : `/${locale}/`;
const academicContent = {
  "en": {
    "title": "Academic | Diego Carrillo",
    "description": "University education in robotics, automation and electronic engineering, complemented by professional studies in networking, cybersecurity, software practices and artificial intelligence.",
    "back": "Back to about",
    "eyebrow": "ACADEMIC",
    "heading": "Built on electronics, robotics and control.",
    "background": "ACADEMIC BACKGROUND",
    "intro": "My studies combine Electronic Engineering, an MSc in Robotics and Automation, and networking. They provide a foundation in control, intelligent systems and connected infrastructure. Studying internationally also strengthened my ability to apply this knowledge in different technical settings.",
    "programmes": [
      [
        "Master’s Degree in Robotics and Automation",
        "Master’s programme at Universidad Carlos III de Madrid covering robotic and automated systems, control, intelligent systems, software integration and experimental validation. The qualification includes the official European Diploma Supplement (SET)."
      ],
      [
        "Electronic Engineering",
        "Engineering programme in analogue and digital electronics, control, industrial automation, electrical machines, communications and data networks. Practical work focused on technical analysis, solution design and hardware/software integration."
      ],
      [
        "Cisco Systems CCNA",
        "Networking studies covering switching, routing, IP services, access control, security, automation and programmability. Practical work focused on configuration, troubleshooting and protection of networked infrastructure."
      ]
    ],
    "additional": "ADDITIONAL STUDIES",
    "additionalIntro": "Further studies in artificial intelligence, network security and software development.",
    "studies": [
      [
        "Neural Networks and Deep Learning",
        "Foundations of neural networks and deep learning, with applications to intelligent systems and data-driven engineering."
      ],
      [
        "Managing Network Security",
        "Network threats, security controls and risk-based practices for protecting connected systems and information flows."
      ],
      [
        "Software Processes and Agile Practices",
        "Iterative delivery, collaborative development, planning and continuous improvement for reliable software."
      ]
    ]
  },
  "nl": {
    "title": "Opleiding | Diego Carrillo",
    "description": "Universitaire opleiding in robotica, automatisering en Electronic Engineering, aangevuld met professionele studies in netwerken, cybersecurity, softwareontwikkeling en kunstmatige intelligentie.",
    "back": "Terug naar Over mij",
    "eyebrow": "OPLEIDING",
    "heading": "Gebouwd op elektronica, robotica en besturing.",
    "background": "ACADEMISCHE ACHTERGROND",
    "intro": "Mijn opleiding combineert elektronica, een MSc in robotica en automatisering, en netwerkstudies. Dat vormt een basis in besturing, intelligente systemen en verbonden infrastructuur. Internationaal studeren leerde me deze kennis in verschillende technische omgevingen toe te passen.",
    "programmes": [
      [
        "MSc in Robotics and Automation",
        "Masteropleiding aan Universidad Carlos III de Madrid in robotica en geautomatiseerde systemen, besturing, intelligente systemen, software-integratie en experimentele validatie. Het diploma omvat het officiële Europese diplomasupplement (SET)."
      ],
      [
        "Electronic Engineering",
        "Engineeringopleiding in analoge en digitale elektronica, besturing, industriële automatisering, elektrische machines, communicatie en datanetwerken. Het praktijkwerk richtte zich op technische analyse, oplossingsontwerp en integratie van hardware en software."
      ],
      [
        "Cisco Systems CCNA",
        "Netwerkstudies in switching, routing, IP-diensten, toegangsbeheer, beveiliging, automatisering en programmeerbaarheid. De praktijkopdrachten richtten zich op configuratie, probleemoplossing en beveiliging van netwerkinfrastructuur."
      ]
    ],
    "additional": "AANVULLENDE STUDIES",
    "additionalIntro": "Aanvullende studies in kunstmatige intelligentie, netwerkbeveiliging en softwareontwikkeling.",
    "studies": [
      [
        "Neurale netwerken en deep learning",
        "Grondslagen van neurale netwerken en deep learning, toegepast op intelligente systemen en datagedreven techniek."
      ],
      [
        "Netwerkbeveiliging beheren",
        "Netwerkdreigingen, beveiligingsmaatregelen en risicogestuurde bescherming van verbonden systemen en informatiestromen."
      ],
      [
        "Softwareprocessen en agile werken",
        "Iteratieve oplevering, gezamenlijke ontwikkeling, planning en continue verbetering voor betrouwbare software."
      ]
    ]
  },
  "de": {
    "title": "Ausbildung | Diego Carrillo",
    "description": "Hochschulausbildung in Robotik, Automatisierung und Electronic Engineering, ergänzt durch berufliche Weiterbildung in Netzwerken, Cybersicherheit, Softwareentwicklung und künstlicher Intelligenz.",
    "back": "Zurück zu Über mich",
    "eyebrow": "AUSBILDUNG",
    "heading": "Fundiert in Elektronik, Robotik und Regelungstechnik.",
    "background": "AKADEMISCHER HINTERGRUND",
    "intro": "Mein Studium verbindet Elektronik, einen MSc in Robotik und Automatisierung sowie Netzwerktechnik. Es bildet die Grundlage für Regelung, intelligente Systeme und vernetzte Infrastruktur. Internationale Studienerfahrungen halfen mir, dieses Wissen in unterschiedlichen technischen Umgebungen anzuwenden.",
    "programmes": [
      [
        "MSc in Robotics and Automation",
        "Masterstudium an der Universidad Carlos III de Madrid in Robotik, Automatisierung, Regelung, intelligenten Systemen, Softwareintegration und experimenteller Validierung. Der Abschluss umfasst den offiziellen europäischen Diplomzusatz (SET)."
      ],
      [
        "Electronic Engineering",
        "Ingenieurstudium in analoger und digitaler Elektronik, Regelung, industrieller Automatisierung, elektrischen Maschinen, Kommunikation und Datennetzen. Praktische Arbeiten vertieften technische Analyse, Lösungsentwurf und die Integration von Hardware und Software."
      ],
      [
        "Cisco Systems CCNA",
        "Netzwerkstudien zu Switching, Routing, IP-Diensten, Zugriffskontrolle, Sicherheit, Automatisierung und Programmierbarkeit. Praktische Aufgaben behandelten Konfiguration, Fehlerbehebung und Schutz vernetzter Infrastruktur."
      ]
    ],
    "additional": "WEITERE STUDIEN",
    "additionalIntro": "Ergänzende Studien in künstlicher Intelligenz, Netzwerksicherheit und Softwareentwicklung.",
    "studies": [
      [
        "Neuronale Netze und Deep Learning",
        "Grundlagen neuronaler Netze und des Deep Learning mit Anwendungen in intelligenten Systemen und datengestützter Technik."
      ],
      [
        "Netzwerksicherheit verwalten",
        "Netzwerkbedrohungen, Sicherheitsmaßnahmen und risikobasierter Schutz vernetzter Systeme und Informationsflüsse."
      ],
      [
        "Softwareprozesse und agile Methoden",
        "Iterative Umsetzung, gemeinsame Entwicklung, Planung und kontinuierliche Verbesserung für zuverlässige Software."
      ]
    ]
  },
  "fr": {
    "title": "Formation | Diego Carrillo",
    "description": "Formation universitaire en robotique, automatisation et génie électronique, complétée par des études en réseaux, cybersécurité, développement logiciel et intelligence artificielle.",
    "back": "Retour à la présentation",
    "eyebrow": "FORMATION",
    "heading": "Un socle en électronique, robotique et automatique.",
    "background": "PARCOURS UNIVERSITAIRE",
    "intro": "Mon parcours associe génie électronique, master en robotique et automatisation et études en réseaux. Il constitue un socle en commande, systèmes intelligents et infrastructures connectées. Étudier à l’international m’a aussi appris à appliquer ces connaissances dans différents environnements techniques.",
    "programmes": [
      [
        "Master en robotique et automatisation",
        "Master à l’Universidad Carlos III de Madrid en robotique, automatisation, commande, systèmes intelligents, intégration logicielle et validation expérimentale. Le diplôme comprend le supplément européen officiel au diplôme (SET)."
      ],
      [
        "Génie électronique",
        "Formation d’ingénieur en électronique analogique et numérique, automatique, automatisation industrielle, machines électriques, communications et réseaux de données. Les travaux pratiques portaient sur l’analyse technique, la conception et l’intégration du matériel et du logiciel."
      ],
      [
        "Cisco Systems CCNA",
        "Études en commutation, routage, services IP, contrôle d’accès, sécurité, automatisation et programmabilité. Les travaux pratiques portaient sur la configuration, le dépannage et la protection des infrastructures réseau."
      ]
    ],
    "additional": "FORMATIONS COMPLÉMENTAIRES",
    "additionalIntro": "Études complémentaires en intelligence artificielle, sécurité des réseaux et développement logiciel.",
    "studies": [
      [
        "Réseaux de neurones et apprentissage profond",
        "Fondements des réseaux de neurones et de l’apprentissage profond, appliqués aux systèmes intelligents et à l’ingénierie fondée sur les données."
      ],
      [
        "Gestion de la sécurité des réseaux",
        "Menaces réseau, mesures de sécurité et protection des systèmes connectés et des flux d’information selon les risques."
      ],
      [
        "Processus logiciels et méthodes agiles",
        "Livraison itérative, développement collaboratif, planification et amélioration continue pour des logiciels fiables."
      ]
    ]
  }
};
const copy = academicContent[locale];
---

<BaseLayout
  locale={locale}
  title={copy.title}
  description={copy.description}
>
  <section class="bg-black px-6 py-8 sm:px-10 lg:px-16">
    <FloatingBackControl href={`${homePath}#about`} label={copy.back} />

    <article class="mx-auto mt-12 max-w-5xl pb-12 sm:mt-14 sm:pb-14">
      <p class="section-eyebrow text-violet-300">{copy.eyebrow}</p>
      <h1 class="interactive-heading page-title mt-5 max-w-4xl text-slate-300">
        {copy.heading}
      </h1>

      <section class="academic-section mt-16" aria-labelledby="university-education">
        <p class="section-label" id="university-education">{copy.background}</p>
        <p class="body-copy-reference mt-6 max-w-3xl text-slate-400">
          {copy.intro}
        </p>

        <div class="learning-list academic-program-list mt-10">
          {copy.programmes.map(([title, description]) => <article class="learning-item neon-box-panel"><h2>{title}</h2><p>{description}</p></article>)}
        </div>
      </section>

      <section class="academic-section mt-20" aria-labelledby="professional-studies">
        <p class="section-label" id="professional-studies">{copy.additional}</p>
        <p class="body-copy-reference mt-6 max-w-3xl text-slate-400">
          {copy.additionalIntro}
        </p>

        <div class="learning-list mt-10">
          {copy.studies.map(([title, description]) => <article class="learning-item neon-box-panel"><h2>{title}</h2><p>{description}</p></article>)}
        </div>
      </section>
    </article>
  </section>
</BaseLayout>

<style>
  .academic-section {
    border-top: 1px solid rgba(196, 181, 253, 0.16);
    padding-top: 2.5rem;
  }

  .section-label {
    color: rgb(196 181 253);
    font-size: var(--type-caption-size);
    font-weight: 600;
    letter-spacing: var(--type-label-letter-spacing);
  }

  .learning-item p:last-child {
    color: rgb(148 163 184);
    font-family: var(--font-sans);
    font-size: var(--type-body-size);
    font-weight: var(--type-body-weight);
    letter-spacing: var(--type-body-letter-spacing);
    line-height: var(--type-body-line-height);
  }

  .learning-list {
    display: grid;
    gap: 1rem;
    max-width: 52rem;
  }

  .learning-item {
    padding: clamp(1.35rem, 3vw, 2rem);
  }

  .learning-item h2 {
    color: rgb(196 181 253);
    font-size: var(--type-card-title-size);
    font-weight: 600;
    letter-spacing: -0.01em;
    line-height: var(--type-card-title-line-height);
  }

  .learning-item p:last-child { margin-top: 0.75rem; }

  @media (min-width: 48.001rem) {
    .learning-item p:last-child {
      display: -webkit-box;
      overflow: hidden;
      -webkit-box-orient: vertical;
      -webkit-line-clamp: 2;
    }

    .academic-program-list .learning-item p:last-child {
      display: block;
      overflow: visible;
      -webkit-line-clamp: unset;
    }

    .academic-program-list .learning-item {
      min-height: 11.5rem;
    }
  }

</style>
