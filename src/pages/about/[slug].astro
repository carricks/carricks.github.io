---
import BaseLayout from "../../layouts/BaseLayout.astro";
import FloatingBackControl from "../../components/common/FloatingBackControl.astro";
import { aboutDestinations } from "../../data/about-destinations.ts";

export function getStaticPaths() {
  return aboutDestinations.filter((destination) => !["experience", "academic"].includes(destination.slug)).map((destination) => ({
    params: { slug: destination.slug },
    props: { destination },
  }));
}

const { destination } = Astro.props;
---

<BaseLayout title={`${destination.label} | Diego Carrillo`} description={destination.summary}>
    <section class="relative isolate min-h-[calc(100svh-5rem)] overflow-hidden px-6 py-10 sm:px-10 lg:px-16">
      <FloatingBackControl href="/#about" label="Back to about" />

      <article class="mx-auto mt-24 max-w-4xl">
        <p class="text-sm font-medium tracking-[0.22em] text-violet-300">{destination.label.toUpperCase()}</p>
        <h1 class="interactive-heading mt-5 text-4xl font-semibold tracking-tight text-slate-400 sm:text-6xl">{destination.title}</h1>
        <p class="mt-8 max-w-3xl text-xl leading-9 text-slate-300">{destination.summary}</p>

        <section class="mt-16 max-w-3xl border-t border-violet-300/15 pt-10">
          <p class="text-sm font-medium tracking-[0.18em] text-violet-300">GLOBAL PERSPECTIVE</p>
          <p class="mt-4 leading-8 text-slate-400">Working and studying across Spain, the Netherlands, Portugal and Latin America has strengthened my ability to adapt technical communication to different teams and operating contexts. These experiences have shown me that dependable engineering relies not only on sound design, but also on shared understanding, careful coordination and respect for local practice.</p>
        </section>
      </article>
    </section>
</BaseLayout>
