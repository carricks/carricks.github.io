---
import { Image } from "astro:assets";
import { projects } from "../../data/projects";
import BaseLayout from "../../layouts/BaseLayout.astro";
import projectBackground from "../../assets/project-plc-schematic-v1.png";

export function getStaticPaths() {
  return projects.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

const { project } = Astro.props;
---

<BaseLayout title={`${project.title} | Diego Carrillo`} description={project.summary}>
    <section class="relative isolate min-h-[calc(100svh-5rem)] overflow-hidden px-6 py-10 sm:px-10 lg:px-16">
      <Image src={projectBackground} alt="" aria-hidden="true" class="absolute inset-0 -z-20 h-full w-full object-cover object-center" />
      <div aria-hidden="true" class="project-background-overlay absolute inset-0 -z-10 bg-[linear-gradient(90deg,rgba(3,3,5,0.97)_0%,rgba(3,3,5,0.93)_48%,rgba(3,3,5,0.67)_100%)]"></div>

      <nav aria-label="Project navigation" class="project-navigation flex flex-wrap gap-3">
        <a href="/#projects" class="interactive-control project-icon-control" aria-label="Back to projects" title="Back to projects">
          <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.1" stroke-linecap="round" stroke-linejoin="round">
            <path d="M20 12H4" />
            <path d="m10 6-6 6 6 6" />
          </svg>
        </a>
      </nav>

      <article class="mx-auto mt-24 max-w-4xl">
        <p class="text-sm font-medium tracking-[0.22em] text-violet-300">PROJECT {project.number}</p>
        <p class="mt-5 text-sm text-slate-400">{project.location}</p>
        <h1 class="interactive-heading mt-4 text-4xl font-semibold tracking-tight text-slate-400 sm:text-6xl">{project.title}</h1>
        <p class="mt-8 max-w-3xl text-xl leading-9 text-slate-300">{project.summary}</p>

        <div class="mt-16 grid gap-12 border-t border-violet-300/15 pt-10 sm:grid-cols-2">
          <section>
            <p class="text-sm font-medium tracking-[0.18em] text-violet-300">CONTRIBUTION</p>
            <p class="mt-4 leading-8 text-slate-400">{project.contribution}</p>
          </section>
          <section>
            <p class="text-sm font-medium tracking-[0.18em] text-violet-300">OUTCOME</p>
            <p class="mt-4 leading-8 text-slate-400">{project.outcome}</p>
          </section>
        </div>

        <section class="mt-14 border-t border-violet-300/15 pt-10">
          <p class="text-sm font-medium tracking-[0.18em] text-violet-300">TECHNICAL SCOPE</p>
          <div class="mt-5 flex flex-wrap gap-3">
            {project.technicalScope.map((item) => <span class="tech-scope-item">{item}</span>)}
          </div>
        </section>
      </article>
    </section>
</BaseLayout>

<style>
  .project-navigation {
    width: fit-content;
  }

  @media (max-width: 48rem) {
    .project-background-overlay { background: rgba(3, 3, 5, 0.94); }
  }

  .project-icon-control {
    align-items: center;
    border: 1px solid rgba(196, 181, 253, 0.3);
    border-radius: 999px;
    color: rgb(148 163 184);
    display: inline-flex;
    height: 2.65rem;
    justify-content: center;
    padding: 0.35rem;
    width: 2.65rem;
  }

  .project-icon-control :global(svg) {
    height: 1.7rem;
    min-height: 1.7rem;
    min-width: 1.7rem;
    transition: filter 180ms ease, transform 180ms ease;
    width: 1.7rem;
  }

  .interactive-control.project-icon-control:hover {
    animation: nav-link-presence 520ms cubic-bezier(0.22, 1, 0.36, 1);
    background: transparent;
    border-color: rgb(196 181 253);
    box-shadow: none;
    color: rgb(196 181 253);
    transform: none;
  }

  .interactive-control.project-icon-control:hover :global(svg) {
    filter: drop-shadow(0 0 5px rgba(167, 139, 250, 0.5)) drop-shadow(0 0 10px rgba(103, 232, 249, 0.12));
    transform: translateY(-1px);
  }

  .interactive-control.project-icon-control:active {
    border-color: rgb(196 181 253);
    box-shadow: none;
    color: rgb(196 181 253);
  }

  .tech-scope-item {
    border: 1px solid rgba(221, 214, 254, 0.3);
    border-radius: 0.7rem;
    background: rgba(167, 139, 250, 0.1);
    color: rgb(221 214 254);
    cursor: default;
    font-size: 0.875rem;
    font-weight: 600;
    padding: 0.55rem 0.8rem;
  }
</style>
