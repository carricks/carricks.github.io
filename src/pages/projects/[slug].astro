    0% { background: rgb(5 5 8); color: rgb(196 181 253); transform: scale(1); }
    42% { background: rgb(196 181 253); border-color: rgb(221 214 254); box-shadow: 0 0 1rem rgba(167,139,250,.36); color: rgb(5 5 8); transform: scale(.965); }
    100% { background: rgba(139,92,246,.15); border-color: rgb(196 181 253); color: white; transform: scale(1); }
  }
