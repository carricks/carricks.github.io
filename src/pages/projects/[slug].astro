---
import { projects } from "../../data/projects";
import BaseLayout from "../../layouts/BaseLayout.astro";
import FloatingBackControl from "../../components/common/FloatingBackControl.astro";

export function getStaticPaths() {
  return projects.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

const { project } = Astro.props;
const isResearchCaseStudy = project.slug === "brain-tumour-mri-classification";
const isGridStabilityCaseStudy = project.slug === "grid-contingency-analysis";
---

<BaseLayout title={`${project.title} | Diego Carrillo`} description={project.summary}>
  {isResearchCaseStudy ? (
    <main class="case-study">
      <section class="case-hero">
        <FloatingBackControl href="/#projects" label="Back to projects" />

        <div class="case-hero-grid">
          <div class="case-hero-copy">
            <p class="case-eyebrow">MASTER'S RESEARCH · COMPUTER VISION</p>
            <h1>Classifying brain tumours from MRI.</h1>
            <p class="case-lead">A complete research prototype that moved from heterogeneous medical images to a convolutional model covering four classes and a usable web interface.</p>
          </div>

          <figure class="hero-visual">
            <div class="scan-frame">
              <button type="button" class="figure-zoom-trigger" data-lightbox-trigger aria-label="Enlarge preprocessed MRI samples">
                <img src="/images/projects/brain-tumour-mri/mri-preprocessing.png" alt="Preprocessed MRI samples showing brain images with and without tumours" />
                <span aria-hidden="true">Expand</span>
              </button>
              <div class="scan-line" aria-hidden="true"></div>
            </div>
            <figcaption>Preprocessed MRI samples from the experimental workflow.</figcaption>
          </figure>
        </div>
      </section>

      <section class="case-section impact-section" aria-labelledby="impact-title">
        <div class="section-heading">
          <p class="case-eyebrow">WHY IT MATTERS</p>
          <h2 id="impact-title">A difficult visual problem with real clinical consequences.</h2>
          <p>Brain and central nervous system tumours are uncommon compared with many cancers, yet their location and heterogeneity make assessment especially demanding. The project explored how computer vision could support image review without replacing specialist judgement.</p>
        </div>
        <div class="metric-grid">
          <article><strong>321,731</strong><span>New brain and CNS cancer cases worldwide in 2022</span></article>
          <article><strong>248,500</strong><span>Estimated deaths worldwide in 2022</span></article>
          <article><strong>4 Classes</strong><span>Meningioma, glioma, pituitary and no tumour</span></article>
        </div>
        <p class="source-note">Global context: <a href="https://gco.iarc.who.int/media/globocan/factsheets/cancers/31-brain-central-nervous-system-fact-sheet.pdf" target="_blank" rel="noreferrer">IARC Global Cancer Observatory, GLOBOCAN 2022</a>. The prototype is research work and is not a validated medical diagnostic device.</p>
      </section>

      <section class="case-section" aria-labelledby="challenge-title">
        <div class="split-copy">
          <div>
            <p class="case-eyebrow">THE CHALLENGE</p>
            <h2 id="challenge-title">Teaching a model to distinguish visually similar patterns.</h2>
          </div>
          <div>
            <p>MRI datasets combine different resolutions, anatomical views and acquisition conditions. Tumours may also share location, shape and texture, making the boundary between classes difficult to learn.</p>
            <p>The work therefore focused as much on data quality and experimental discipline as on model architecture: combining public datasets, removing samples with insufficient quality, balancing classes and keeping test images outside augmentation.</p>
          </div>
        </div>
        <div class="class-grid" aria-label="Classification targets">
          {[
            { title: "MENINGIOMA", copy: "Tumour arising from the meninges surrounding the brain.", image: "class-meningioma.png" },
            { title: "GLIOMA", copy: "Tumour originating in glial cells, with highly variable appearance.", image: "class-glioma.png" },
            { title: "PITUITARY", copy: "Tumour located around the pituitary gland at the base of the brain.", image: "class-pituitary.png" },
            { title: "NO TUMOUR", copy: "MRI samples without evidence of the three target tumour classes.", image: "class-no-tumour.png" },
          ].map(({ title, copy, image }) => (
            <article>
              <button type="button" class="figure-zoom-trigger class-image-trigger" data-lightbox-trigger aria-label={`Enlarge MRI example classified as ${title.toLowerCase()}`}>
                <img src={`/images/projects/brain-tumour-mri/${image}`} alt={`MRI example classified as ${title.toLowerCase()}`} />
                <span aria-hidden="true">Expand</span>
              </button>
              <div><h3>{title}</h3><p>{copy}</p></div>
            </article>
          ))}
        </div>
      </section>

      <section class="case-section" aria-labelledby="pipeline-title">
        <div class="section-heading compact-heading">
          <p class="case-eyebrow">RESEARCH PIPELINE</p>
          <h2 id="pipeline-title">From raw images to an interpretable prediction.</h2>
        </div>
        <ol class="pipeline">
          <li><span>DATA</span><div><strong>Prepare the MRI dataset</strong><p>Combine three public collections, remove unsuitable samples, standardise every image and create independent training, validation and test sets.</p></div></li>
          <li><span>MODEL</span><div><strong>Train through transfer learning</strong><p>Apply controlled augmentation and adapt the visual features learned by VGG16 to distinguish the four MRI classes.</p></div></li>
          <li><span>OUTPUT</span><div><strong>Evaluate and deliver predictions</strong><p>Assess performance across every class and serve the resulting probabilities through a Flask application with numerical and visual results.</p></div></li>
        </ol>
      </section>

      <section class="case-section visual-story" aria-labelledby="model-title">
        <div class="split-copy">
          <div>
            <p class="case-eyebrow">MODEL EVOLUTION</p>
            <h2 id="model-title">The first model revealed the problem. VGG16 made it scalable.</h2>
          </div>
          <div>
            <p>An initial CNN covering two classes established the preprocessing and evaluation workflow, but its small dataset produced unstable validation behaviour. Increasing and cleaning the data improved the experiment before expanding it to four classes.</p>
            <p>Transfer learning reused VGG16's pretrained visual features. Freezing most of the network and adapting the output reduced the trainable portion to roughly 16,000 parameters for the target classification task.</p>
          </div>
        </div>
        <figure class="research-figure wide-figure">
          <button type="button" class="figure-zoom-trigger" data-lightbox-trigger aria-label="Enlarge VGG16 architecture diagram">
            <img src="/images/projects/brain-tumour-mri/vgg16-architecture.png" alt="VGG16 transfer learning architecture used for MRI classification across four classes" />
            <span aria-hidden="true">Expand</span>
          </button>
          <figcaption>VGG16 transfer learning architecture adapted during the research.</figcaption>
        </figure>
        <div class="experiment-grid">
          <article><div><span>INITIAL EXPERIMENT</span><strong>CNN baseline with two classes</strong><p>A custom convolutional network used 620 images of meningioma and cases without a tumour to validate the complete workflow. Its unstable validation behaviour exposed overfitting and the limits of a small dataset.</p></div></article>
          <article><div><span>FINAL EXPERIMENT</span><strong>Transfer learning across four classes</strong><p>The study expanded to 5,320 balanced images covering meningioma, glioma, pituitary and no tumour. VGG16 transfer learning reduced the trainable output to roughly 16,000 parameters.</p></div></article>
          <article><div><span>INPUT SHAPE</span><strong>224 × 224 × 3</strong><p>Every source image was resized and converted to a consistent tensor with three channels. This common input made heterogeneous resolutions compatible with the same feature extraction pipeline.</p></div></article>
        </div>
      </section>

      <section class="case-section" aria-labelledby="data-title">
        <div class="split-copy">
          <div>
            <p class="case-eyebrow">DATA STRATEGY</p>
            <h2 id="data-title">More data helped. Better controlled data mattered more.</h2>
          </div>
          <div><p>The final experiment used 5,320 MRI images with balanced class counts. A 70/20/10 strategy separated learning, model selection and final evaluation, while augmentation introduced controlled rotations, shifts, zoom and flips exclusively during training.</p></div>
        </div>
        <div class="dataset-bar" aria-label="Dataset distribution">
          <div class="train"><strong>3,720</strong><span>Training · 70%</span></div>
          <div class="validation"><strong>1,080</strong><span>Validation · 20%</span></div>
          <div class="test"><strong>520</strong><span>Test · 10%</span></div>
        </div>
        <figure class="research-figure">
          <button type="button" class="figure-zoom-trigger" data-lightbox-trigger aria-label="Enlarge MRI data augmentation examples">
            <img src="/images/projects/brain-tumour-mri/data-augmentation.png" alt="MRI image and augmented variants used during model training" />
            <span aria-hidden="true">Expand</span>
          </button>
          <figcaption>Controlled augmentation generated new training variants while preserving the original anatomy.</figcaption>
        </figure>
        <section class="dataset-sources" aria-labelledby="sources-title">
          <div>
            <p class="case-eyebrow">OPEN ACADEMIC DATA</p>
            <h3 id="sources-title">Where the MRI images came from.</h3>
            <p>The research combined publicly accessible MRI collections used for academic experimentation. Images from the different sources were reviewed, reorganised and filtered before entering the common training workflow.</p>
          </div>
          <div class="source-links">
            <a class="interactive-control neon-box-control premium-neon-control dataset-source-card" href="https://figshare.com/articles/dataset/brain_tumor_dataset/1512427" target="_blank" rel="noreferrer">
              <span>FIGSHARE</span><strong>Brain Tumor Dataset</strong><small>3,064 T1 weighted MRI images with contrast enhancement across three tumour classes. CC BY 4.0.</small>
              <span class="dataset-source-arrow neon-box-arrow" aria-hidden="true">↗</span>
            </a>
            <a class="interactive-control neon-box-control premium-neon-control dataset-source-card" href="https://www.kaggle.com/datasets/sartajbhuvaji/brain-tumor-classification-mri" target="_blank" rel="noreferrer">
              <span>KAGGLE</span><strong>Brain Tumor Classification (MRI)</strong><small>Public academic collection organised around glioma, meningioma, pituitary and images without a tumour.</small>
              <span class="dataset-source-arrow neon-box-arrow" aria-hidden="true">↗</span>
            </a>
            <a class="interactive-control neon-box-control premium-neon-control dataset-source-card" href="https://github.com/MohamedAliHabib/Brain-Tumor-Detection" target="_blank" rel="noreferrer">
              <span>GITHUB</span><strong>Brain Tumor Detection Dataset</strong><small>Open reference repository containing MRI samples and CNN experimentation material.</small>
              <span class="dataset-source-arrow neon-box-arrow" aria-hidden="true">↗</span>
            </a>
          </div>
        </section>
      </section>

      <section class="case-section" aria-labelledby="results-title">
        <div class="section-heading compact-heading">
          <p class="case-eyebrow">EXPERIMENTAL RESULTS</p>
          <h2 id="results-title">Strong results across classes, with visible room for improvement.</h2>
          <p>The model covering four classes reached 88.17% training accuracy. Evaluation of each class showed that glioma remained the most difficult category, reinforcing the effect of visual similarity and dataset quality.</p>
        </div>
        <figure class="benchmark-figure">
          <div class="benchmark-chart" role="group" aria-label="Comparison between target class reference results and the predicted label performance of the applied model">
            <section class="performance-card" aria-labelledby="comparison-chart-title">
              <div class="benchmark-panel-heading">
                <span>COMPARISON BY CLASS</span>
                <strong id="comparison-chart-title">Target benchmark compared with predicted label accuracy</strong>
                <div class="chart-legend" aria-label="Chart legend"><span><i class="target-key"></i>Target benchmark</span><span><i class="predicted-key"></i>Predicted label</span></div>
              </div>
              <div class="comparison-plot">
                {[
                  { label: "Meningioma", target: "74.0", predicted: "95.38" },
                  { label: "Glioma", target: "85.7", predicted: "81.54" },
                  { label: "Pituitary", target: "88.4", predicted: "87.66" },
                  { label: "No tumour", target: null, predicted: "93.08" },
                ].map(({ label, target, predicted }) => (
                  <div class="comparison-group">
                    <strong class="comparison-class">{label}</strong>
                    <div class="comparison-series">
                      <span class="series-name">Target</span>
                      <div class:list={["comparison-track", !target && "is-unavailable"]}>{target && <span class="target-bar" style={`--score:${target}%`}></span>}</div>
                      <strong class="series-value">{target ? `${target}%` : "N/A"}{!target && <small>Not evaluated</small>}</strong>
                    </div>
                    <div class="comparison-series">
                      <span class="series-name">Predicted</span>
                      <div class="comparison-track"><span class="predicted-bar" style={`--score:${predicted}%`}></span></div>
                      <strong class="series-value">{predicted}%</strong>
                    </div>
                  </div>
                ))}
                <div class="comparison-scale" aria-hidden="true"><div class="comparison-axis"><span>0</span><span>25</span><span>50</span><span>75</span><span>100</span></div><strong>Accuracy (%)</strong></div>
              </div>
            </section>
          </div>
          <figcaption>
            <strong>Impact of the applied techniques.</strong>
            <span>Data cleaning, class balancing and controlled augmentation produced a substantial improvement in prediction accuracy. Combined with transfer learning, the final model surpassed the initial benchmark in its strongest classes and added reliable detection of the category without a tumour.</span>
          </figcaption>
        </figure>
      </section>

      <section class="case-section application-section" aria-labelledby="application-title">
        <div class="split-copy">
          <div>
            <p class="case-eyebrow">FROM MODEL TO PRODUCT</p>
            <h2 id="application-title">From trained model to functional application.</h2>
          </div>
          <div>
            <p>As part of the study, I developed a web application that connected the trained Keras model to a Python and Flask backend. Users could submit an MRI image and receive probabilities across four classes, presented numerically and through D3.js visualisations, demonstrating how the research model could operate within a practical workflow for users.</p>
            <p class="prediction-study-copy">To demonstrate the complete inference workflow, a pituitary MRI sample was submitted to the application. The report records the selected image, the probability assigned to each class and the final classification returned by the model.</p>
          </div>
        </div>
        <figure class="prediction-report">
          <button type="button" class="figure-zoom-trigger prediction-report-image" data-lightbox-trigger aria-label="Enlarge pituitary tumour MRI input">
            <img src="/images/projects/brain-tumour-mri/class-pituitary.png" alt="Pituitary tumour MRI selected as input for prediction across four classes" />
            <span aria-hidden="true">Expand</span>
          </button>
          <pre aria-label="Prediction report covering four classes">========================================
MRI CLASSIFICATION REPORT
========================================

INPUT DATA
FILE............. pituitary (654).png
INPUT TYPE....... MRI IMAGE
MODEL OUTPUT..... FOUR CLASSES

PREDICTION SCORES
MENINGIOMA....... 0.007176
NO TUMOUR........ 0.000283
GLIOMA........... 0.051178
PITUITARY........ 0.941363

PRIMARY CLASSIFICATION
LABEL............ PITUITARY
CONFIDENCE....... 94.1363%

REPORT STATUS.... COMPLETE
END OF REPORT
========================================</pre>
          <figcaption>Pituitary MRI input and the four probability values returned by the trained model.</figcaption>
        </figure>
      </section>

      <section class="case-section responsible-use-section" aria-labelledby="responsible-use-title">
        <div class="section-heading compact-heading">
          <p class="case-eyebrow">RESPONSIBLE USE</p>
          <h2 id="responsible-use-title">Responsible use boundary.</h2>
          <p>This research prototype supports experimentation and cannot replace diagnosis by qualified medical professionals.</p>
        </div>
        <a href="/documents/master-thesis-brain-tumour-mri.pdf" class="interactive-control neon-box-control premium-neon-control report-access-control" data-report-open>
          <span class="neon-box-label">Explore report</span>
        </a>
      </section>

      <section class="case-section technology-section" aria-labelledby="technology-title">
        <div class="section-heading compact-heading">
          <p class="case-eyebrow">TECHNICAL FOUNDATION</p>
          <h2 id="technology-title">Tools behind the research.</h2>
          <p>The stack connected model development, accelerated experimentation, backend inference and visualisation in the browser within one complete workflow.</p>
        </div>
        <div class="case-tags" aria-label="Core technologies">
          {project.technicalScope.map((item) => <span>{item}</span>)}
        </div>
      </section>

      <footer class="case-footer">
        <div class="research-references">
          <span>RESEARCH INTEGRITY</span>
          <a href="https://www.allea.org/wp-content/uploads/2017/05/ALLEA-European-Code-of-Conduct-for-Research-Integrity-2017.pdf" target="_blank" rel="noopener noreferrer">
            <img src="/images/allea-logo-lilac.png" alt="ALLEA" />
            <span>The European Code of Conduct for Research Integrity</span>
          </a>
        </div>
      </footer>

      <dialog class="figure-lightbox" data-figure-lightbox aria-label="Expanded VGG16 architecture diagram">
        <div class="figure-lightbox-content">
          <button type="button" class="figure-lightbox-close" data-figure-close aria-label="Close enlarged image">×</button>
          <img data-lightbox-image src="/images/projects/brain-tumour-mri/vgg16-architecture.png" alt="Expanded research figure" />
        </div>
      </dialog>

      <dialog class="report-viewer" data-report-viewer aria-label="Academic research report">
        <div class="report-viewer-content">
          <button type="button" class="report-viewer-close" data-report-close aria-label="Close research report">
            <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
              <path d="M6 6l12 12M18 6L6 18" />
            </svg>
          </button>
          <iframe title="Academic research report" data-report-frame data-source="/documents/master-thesis-brain-tumour-mri.pdf#toolbar=0&navpanes=0&scrollbar=1&view=FitH"></iframe>
        </div>
      </dialog>
    </main>
  ) : isGridStabilityCaseStudy ? (
    <main class="case-study grid-case-study">
      <section class="case-hero">
        <FloatingBackControl href="/#projects" label="Back to projects" />

        <div class="case-hero-grid">
          <div class="case-hero-copy">
            <p class="case-eyebrow">PROFESSIONAL CONTRIBUTION · POWER SYSTEMS</p>
            <h1>Transmission grid stability decision support.</h1>
            <p class="case-lead">Collaborative software engineering for applications that evaluate controlled network contingencies and help specialists understand transmission system behaviour.</p>
          </div>

          <figure class="grid-hero-visual">
            <button type="button" class="figure-zoom-trigger grid-architecture-trigger" data-lightbox-trigger aria-label="Enlarge conceptual transmission stability system architecture">
              <img src="/images/projects/grid-stability/system-architecture.png" alt="Conceptual architecture linking the power system, PMU devices, a VAMS server, database, stability assessment model, visualisation and operators" />
              <span aria-hidden="true">Expand</span>
            </button>
            <figcaption>Conceptual system architecture reconstructed for this portfolio from the public engineering workflow.</figcaption>
          </figure>
        </div>
      </section>

      <section class="case-section" aria-labelledby="grid-context-title">
        <div class="split-copy">
          <div>
            <p class="case-eyebrow">OPERATIONAL CONTEXT</p>
            <h2 id="grid-context-title">Supporting stability across a complex transmission environment.</h2>
          </div>
          <div>
            <p>The project supports one of Europe’s leading electricity transmission operators, responsible for the Dutch high voltage grid and a substantial part of the German network.</p>
            <p>As renewable generation, interconnection and operational complexity increase, engineering teams need dependable applications that convert network conditions into structured simulations and reviewable technical results.</p>
          </div>
        </div>
        <div class="network-context-layout">
          <figure class="network-context-map">
            <button type="button" class="figure-zoom-trigger" data-lightbox-trigger aria-label="Enlarge conceptual map of the Dutch transmission grid and North Sea connections">
              <img src="/images/projects/grid-stability/dutch-grid-context.png" alt="Conceptual map highlighting the Netherlands, its transmission network, North Sea wind areas, energy hubs and regional corridors" />
              <span aria-hidden="true">Expand</span>
            </button>
            <figcaption>Conceptual reconstruction of the regional grid vision, centred on the Netherlands.</figcaption>
          </figure>
          <div class="network-context-metrics" aria-label="Future electricity system planning context">
            <article><span>PLANNING HORIZON</span><strong>2045</strong><p>A long term grid vision connecting offshore generation, energy hubs and reinforced continental infrastructure.</p></article>
            <article><span>ELECTRICITY DEMAND</span><strong>More than 2x</strong><p>Projected consumption could more than double across the Dutch and German energy systems.</p></article>
            <article><span>GENERATION CAPACITY</span><strong>5x to 10x</strong><p>Future scenarios anticipate a major expansion of generation capacity as electrification accelerates.</p></article>
            <article><span>OFFSHORE WIND</span><strong>About 70 GW</strong><p>The planning context considers approximately 70 GW of offshore wind for each country.</p></article>
            <p class="source-note">Future planning context: <a href="https://www.offshorewind.biz/2023/04/13/tennet-unveils-electricity-grid-plans-for-2045/" target="_blank" rel="noopener noreferrer">Electricity grid plans for 2045</a>. The map is a conceptual portfolio reconstruction, not an operational network diagram.</p>
          </div>
        </div>
      </section>

      <section class="case-section" aria-labelledby="contingency-title">
        <div class="section-heading compact-heading">
          <p class="case-eyebrow">CONTINGENCY DRIVEN ANALYSIS</p>
          <h2 id="contingency-title">Controlled disturbances reveal how the system responds.</h2>
          <p>A contingency represents a defined change introduced into a network simulation. Rather than predicting an incident in isolation, the application evaluates the resulting system response under selected operating conditions.</p>
        </div>
        <div class="contingency-grid">
          <article><span>LINE EVENT</span><strong>Transmission path unavailable</strong><p>A conceptual line outage tests how power flows redistribute through the remaining network.</p></article>
          <article><span>GENERATION EVENT</span><strong>Sudden production loss</strong><p>A controlled generation loss helps reveal frequency and stability behaviour after an imbalance.</p></article>
          <article><span>NETWORK EVENT</span><strong>Temporary electrical fault</strong><p>A simulated disturbance allows specialists to examine whether the system returns to an acceptable state.</p></article>
        </div>
        <p class="concept-note">The examples are general engineering scenarios and do not reproduce operational configurations or internal assessment criteria.</p>
      </section>

      <section class="case-section" aria-labelledby="grid-flow-title">
        <div class="section-heading compact-heading">
          <p class="case-eyebrow">ANALYSIS WORKFLOW</p>
          <h2 id="grid-flow-title">From operational context to reviewable evidence.</h2>
        </div>
        <ol class="pipeline grid-pipeline">
          <li><span>INPUT</span><div><strong>Prepare the operating scenario</strong><p>Transform validated network information and a selected contingency into consistent inputs for the simulation environment.</p></div></li>
          <li><span>SIMULATION</span><div><strong>Evaluate system response</strong><p>Coordinate specialist tools that calculate how the transmission system behaves during and after the controlled disturbance.</p></div></li>
          <li><span>REVIEW</span><div><strong>Deliver traceable results</strong><p>Present structured outputs that engineering specialists can verify, compare and use within established decision processes.</p></div></li>
        </ol>
      </section>

      <section class="case-section" aria-labelledby="contribution-title">
        <div class="split-copy">
          <div>
            <p class="case-eyebrow">ENGINEERING CONTRIBUTION</p>
            <h2 id="contribution-title">Software built within a multidisciplinary delivery environment.</h2>
          </div>
          <div>
            <p>My contribution covers the design, development, testing and deployment of application components across offline and online environments. The work connects software engineering with power system analysis, data preparation and operational requirements.</p>
            <p>I also support integration with existing infrastructure and specialist simulation tools, validating datasets, inputs and outputs so that results remain accurate, reproducible and suitable for technical review.</p>
          </div>
        </div>
      </section>

      <section class="case-section crof-section" aria-labelledby="crof-title">
        <div class="section-heading compact-heading crof-heading">
          <p class="case-eyebrow">CONTROL ROOM OF THE FUTURE</p>
          <h2 id="crof-title">A more integrated environment for operational decision support.</h2>
          <p>CRoF brings grid data, network models, security assessment and decision support into a coordinated environment. Its purpose is to combine automation with human supervision as system complexity grows.</p>
        </div>
        <div class="crof-gallery">
          <figure>
            <button type="button" class="figure-zoom-trigger" data-lightbox-trigger aria-label="Enlarge future electricity control room view">
              <img src="/images/projects/grid-stability/control-room-future.png" alt="Three operators reviewing network diagrams and operational displays in an integrated electricity control room" />
              <span aria-hidden="true">Expand</span>
            </button>
            <figcaption>Integrated monitoring places network behaviour and operational evidence within one review environment.</figcaption>
          </figure>
          <figure>
            <button type="button" class="figure-zoom-trigger" data-lightbox-trigger aria-label="Enlarge grid management facility view">
              <img src="/images/projects/grid-stability/grid-management-facility.png" alt="Isometric engineering view of a secured grid management facility and high voltage infrastructure" />
              <span aria-hidden="true">Expand</span>
            </button>
            <figcaption>Operational software remains connected to the physical infrastructure it helps specialists understand.</figcaption>
          </figure>
        </div>
      </section>

      <section class="case-section literature-section" aria-labelledby="literature-title">
        <div class="split-copy">
          <div>
            <p class="case-eyebrow">RELATED RESEARCH</p>
            <h2 id="literature-title">Online assessment connects system behaviour with visual decision support.</h2>
          </div>
          <div>
            <p>Published research also explores data driven online assessment combined with spatial and temporal visualisation. This reinforces a central principle of the project: simulation output creates greater value when specialists can interpret system behaviour through structured and accessible evidence.</p>
            <a class="interactive-control neon-box-control premium-neon-control literature-link" href="https://doi.org/10.1016/j.ijepes.2020.106316" target="_blank" rel="noopener noreferrer">
              <span class="neon-box-label">Explore related paper</span>
            </a>
          </div>
        </div>
      </section>

      <section class="case-section" aria-labelledby="reflection-title">
        <div class="section-heading compact-heading">
          <p class="case-eyebrow">PROFESSIONAL REFLECTION</p>
          <h2 id="reflection-title">Engineering value emerges through collaboration and disciplined integration.</h2>
        </div>
        <div class="experiment-grid grid-reflection">
