  .interactive-model-controls button { background: rgb(5 5 8); border: 1px solid rgba(196,181,253,.3); border-radius: 999px; color: rgb(196 181 253); cursor: pointer; font-size: .76rem; inline-size: 6.75rem; min-height: 2.55rem; padding: .55rem .45rem; transition: background-color .2s ease,border-color .2s ease,color .2s ease; white-space: nowrap; }
  .interactive-model-controls button:hover,
  .interactive-model-controls button:focus-visible { background: rgba(139,92,246,.15); border-color: rgb(196 181 253); color: white; }
  .interactive-model-controls button.is-control-confirmed { animation: model-control-confirm 360ms cubic-bezier(.22,1,.36,1); }
