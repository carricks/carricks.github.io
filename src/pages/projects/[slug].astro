---
import { projects } from "../../data/projects";
import BaseLayout from "../../layouts/BaseLayout.astro";
import FloatingBackControl from "../../components/common/FloatingBackControl.astro";

export function getStaticPaths() {
  return projects.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

const { project } = Astro.props;
const isResearchCaseStudy = project.slug === "brain-tumour-mri-classification";
const isGridStabilityCaseStudy = project.slug === "grid-contingency-analysis";
const isRenewableControlCaseStudy = project.slug === "renewable-plant-control";
const isTelecomCoverageCaseStudy = project.slug === "telecommunications-coverage-deployment";

const pieCenter = { x: 60, y: 53 };
const pieRadius = 44;
const polarPoint = (angle: number, radius = pieRadius) => {
  const radians = (angle * Math.PI) / 180;
  return { x: pieCenter.x + radius * Math.cos(radians), y: pieCenter.y + radius * Math.sin(radians) };
};
const piePath = (start: number, end: number) => {
  const from = polarPoint(start);
  const to = polarPoint(end);
  return `M ${pieCenter.x} ${pieCenter.y} L ${from.x.toFixed(3)} ${from.y.toFixed(3)} A ${pieRadius} ${pieRadius} 0 ${end - start > 180 ? 1 : 0} 1 ${to.x.toFixed(3)} ${to.y.toFixed(3)} Z`;
};
const pieEdgePath = (start: number, end: number, depth = 22) => {
  const from = polarPoint(start);
  const to = polarPoint(end);
  return `M ${from.x.toFixed(3)} ${from.y.toFixed(3)} V ${(from.y + depth).toFixed(3)} M ${to.x.toFixed(3)} ${to.y.toFixed(3)} V ${(to.y + depth).toFixed(3)}`;
};
let pieAngle = -80;
const predictionPie = [
  { label: "Pituitary", value: 94.1363, className: "is-pituitary", offset: 1.5 },
  { label: "Glioma", value: 5.1178, className: "is-glioma", offset: 3.4 },
  { label: "Meningioma", value: 0.7176, className: "is-meningioma", offset: 4.2 },
  { label: "No tumour", value: 0.0283, className: "is-no-tumour", offset: 4.8 },
].map((slice) => {
  const start = pieAngle;
  const end = start + slice.value * 3.6;
  const midpoint = (start + end) / 2;
  const radians = (midpoint * Math.PI) / 180;
  pieAngle = end;
  return {
    ...slice,
    path: piePath(start, end),
    edgePath: pieEdgePath(start, end),
    transform: `translate(${(Math.cos(radians) * slice.offset).toFixed(2)} ${(Math.sin(radians) * slice.offset).toFixed(2)})`,
  };
});
const pieMeshSpokes = Array.from({ length: 32 }, (_, index) => {
  const point = polarPoint(index * 11.25, 46);
  return `M ${pieCenter.x} ${pieCenter.y} L ${point.x.toFixed(3)} ${point.y.toFixed(3)}`;
}).join(" ");
---

<BaseLayout title={`${project.title} | Diego Carrillo`} description={project.summary}>
  {isResearchCaseStudy ? (
    <main class="case-study">
      <section class="case-hero">
        <FloatingBackControl href="/#projects" label="Back to projects" />

        <div class="case-hero-grid">
          <div class="case-hero-copy">
            <p class="case-eyebrow">MASTER'S RESEARCH · COMPUTER VISION</p>
            <h1>Classifying brain tumours from MRI.</h1>
            <p class="case-lead">A complete research prototype that transforms heterogeneous medical images into predictions across four classes through a convolutional model and a usable web interface.</p>
            <a href="/documents/master-thesis-brain-tumour-mri.pdf" class="report-access-control" data-report-open>
              <span>Explore report</span>
              <svg viewBox="0 0 18 18" aria-hidden="true"><path d="M5 13 13 5M7 5h6v6" /></svg>
            </a>
          </div>

          <figure class="hero-visual">
            <div class="scan-frame">
              <button type="button" class="figure-zoom-trigger" data-lightbox-trigger aria-label="Enlarge preprocessed MRI samples">
                <img src="/images/projects/brain-tumour-mri/mri-preprocessing.png" alt="Preprocessed MRI samples showing brain images with and without tumours" />
                <span aria-hidden="true">Expand</span>
              </button>
              <div class="scan-line" aria-hidden="true"></div>
            </div>
            <figcaption>Preprocessed MRI samples from the experimental workflow.</figcaption>
          </figure>
        </div>

        <section class="interactive-model" aria-labelledby="interactive-model-title">
          <div class="interactive-model-heading">
            <div>
              <p class="case-eyebrow">INTERACTIVE 3D</p>
              <h2 id="interactive-model-title">Explore the tumour model.</h2>
            </div>
            <div class="interactive-model-controls" aria-label="Interactive model controls">
              <button type="button" data-second-model-reset disabled>Reset View</button>
              <button type="button" data-second-tumour-toggle aria-pressed="true" disabled>Hide Tumor</button>
            </div>
          </div>
          <div class="interactive-model-frame">
            <iframe
              data-second-sketchfab-viewer
              title="3D Brain Tumor Model"
              allow="autoplay; fullscreen; xr-spatial-tracking"
              allowfullscreen
            ></iframe>
          </div>
          <div class="interactive-model-meta">
            <span>Drag to rotate · scroll or pinch to zoom</span>
            <span><a href="https://sketchfab.com/3d-models/3d-brain-tumor-model-a2e063b2d65a4a5190e1de85b7e16dcd" target="_blank" rel="nofollow noreferrer">3D Brain Tumor Model</a> by Rafael G. Malanga on Sketchfab.</span>
          </div>
          <div class="interactive-model-variant">
            <div class="interactive-model-heading">
              <div class="interactive-model-controls" aria-label="Second interactive model controls">
                <button type="button" data-model-reset disabled>Reset View</button>
                <button type="button" data-tumour-toggle aria-pressed="true" disabled>Hide Tumor</button>
                <button type="button" data-tags-toggle aria-pressed="true" disabled>Hide Tags</button>
              </div>
            </div>
            <div class="interactive-model-frame">
              <iframe data-sketchfab-viewer title="CT Skull and Brain, with Tumor" allow="autoplay; fullscreen; xr-spatial-tracking" allowfullscreen></iframe>
            </div>
            <div class="interactive-model-meta">
              <span>Drag to rotate · scroll or pinch to zoom</span>
              <span><a href="https://sketchfab.com/3d-models/ct-skull-and-brain-with-tumor-df80f6027970411d8446af01fcb76b1a" target="_blank" rel="nofollow noreferrer">CT Skull and Brain, with Tumor</a> by AlorE on Sketchfab.</span>
            </div>
          </div>
        </section>
        <script is:inline src="https://static.sketchfab.com/api/sketchfab-viewer-1.12.1.js"></script>
      </section>

      <section class="case-section impact-section" aria-labelledby="impact-title">
        <div class="section-heading">
          <p class="case-eyebrow">WHY IT MATTERS</p>
          <h2 id="impact-title">A difficult visual problem with real clinical consequences.</h2>
          <p>Brain and central nervous system tumours are uncommon compared with many cancers, yet their location and heterogeneity make assessment especially demanding. The project explored how computer vision could support image review without replacing specialist judgement.</p>
        </div>
        <div class="metric-grid">
          <article><strong>321,731</strong><span>New brain and CNS cancer cases worldwide in 2022</span></article>
          <article><strong>248,500</strong><span>Estimated deaths worldwide in 2022</span></article>
          <article><strong>4 Classes</strong><span>Meningioma, glioma, pituitary and no tumour</span></article>
        </div>
        <p class="source-note">Global context: <a href="https://gco.iarc.who.int/media/globocan/factsheets/cancers/31-brain-central-nervous-system-fact-sheet.pdf" target="_blank" rel="noreferrer">IARC Global Cancer Observatory, GLOBOCAN 2022</a>. The prototype is research work and is not a validated medical diagnostic device.</p>
      </section>

      <section class="case-section" aria-labelledby="challenge-title">
        <div class="split-copy">
          <div>
            <p class="case-eyebrow">THE CHALLENGE</p>
            <h2 id="challenge-title">Teaching a model to distinguish visually similar patterns.</h2>
          </div>
          <div>
            <p>MRI datasets combine different resolutions, anatomical views and acquisition conditions. Tumours may also share location, shape and texture, making the boundary between classes difficult to learn.</p>
            <p>The work therefore focused as much on data quality and experimental discipline as on model architecture: combining public datasets, removing samples with insufficient quality, balancing classes and keeping test images outside augmentation.</p>
          </div>
        </div>
        <div class="class-grid" aria-label="Classification targets">
          {[
            { title: "MENINGIOMA", copy: "Tumour arising from the meninges surrounding the brain.", image: "class-meningioma.png" },
            { title: "GLIOMA", copy: "Tumour originating in glial cells, with highly variable appearance.", image: "class-glioma.png" },
            { title: "PITUITARY", copy: "Tumour located around the pituitary gland at the base of the brain.", image: "class-pituitary.png" },
            { title: "NO TUMOUR", copy: "MRI samples without evidence of the three target tumour classes.", image: "class-no-tumour-clean.png" },
          ].map(({ title, copy, image }) => (
            <article>
              <button type="button" class="figure-zoom-trigger class-image-trigger" data-lightbox-trigger aria-label={`Enlarge MRI example classified as ${title.toLowerCase()}`}>
                <img src={`/images/projects/brain-tumour-mri/${image}`} alt={`MRI example classified as ${title.toLowerCase()}`} />
                <span aria-hidden="true">Expand</span>
              </button>
              <div><h3>{title}</h3><p>{copy}</p></div>
            </article>
          ))}
        </div>
      </section>

      <section class="case-section" aria-labelledby="pipeline-title">
        <div class="section-heading compact-heading">
          <p class="case-eyebrow">RESEARCH PIPELINE</p>
          <h2 id="pipeline-title">From raw images to an interpretable prediction.</h2>
        </div>
        <ol class="plant-flow" aria-label="MRI research workflow">
          <li>
            <span class="plant-flow-symbol" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M6 2h8l4 4v16H6V2Z"/><path d="M14 2v5h5M9 11h6M9 15h6M9 19h4"/></svg>
            </span>
            <div><span>DATA</span><strong>Prepare the MRI dataset</strong><p>Combine public collections, remove unsuitable samples and separate training, validation and test data.</p></div>
          </li>
          <li>
            <span class="plant-flow-symbol" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="16" rx="2"/><path d="M3 8h18M7 6h.01M10 6h.01M8.5 12.5 6 15l2.5 2.5M15.5 12.5 18 15l-2.5 2.5M13.5 11.5l-3 7"/></svg>
            </span>
            <div><span>MODEL</span><strong>Train through transfer learning</strong><p>Use controlled augmentation and adapt VGG16 visual features to distinguish the four MRI classes.</p></div>
          </li>
          <li>
            <span class="plant-flow-symbol" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="13" rx="2"/><path d="M7 13V9M11 13V7M15 13v-3M19 13V6M9 21h6M12 17v4"/></svg>
            </span>
            <div><span>OUTPUT</span><strong>Evaluate and deliver predictions</strong><p>Assess every class and serve probabilities through a Flask application with numerical and visual results.</p></div>
          </li>
        </ol>
      </section>

      <section class="case-section visual-story" aria-labelledby="model-title">
        <div class="split-copy">
          <div>
            <p class="case-eyebrow">MODEL EVOLUTION</p>
            <h2 id="model-title">The first model revealed the problem. VGG16 made it scalable.</h2>
          </div>
          <div>
            <p>An initial CNN covering two classes established the preprocessing and evaluation workflow, but its small dataset produced unstable validation behaviour. Increasing and cleaning the data improved the experiment before expanding it to four classes.</p>
            <p>Transfer learning reused VGG16's pretrained visual features. Freezing most of the network and adapting the output reduced the trainable portion to roughly 16,000 parameters for the target classification task.</p>
          </div>
        </div>
        <figure class="research-figure wide-figure vgg16-figure">
          <button type="button" class="figure-zoom-trigger" data-lightbox-trigger aria-label="Enlarge VGG16 architecture diagram">
            <img src="/images/projects/brain-tumour-mri/vgg16-architecture-lilac-approved-v2.png" alt="VGG16 transfer learning architecture used for MRI classification across four classes" />
            <span aria-hidden="true">Expand</span>
          </button>
          <figcaption>VGG16 transfer learning architecture adapted during the research.</figcaption>
        </figure>
        <ol class="plant-flow" aria-label="MRI model evolution">
          <li>
            <span class="plant-flow-symbol" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="5" cy="8" r="2"/><circle cx="5" cy="16" r="2"/><circle cx="12" cy="12" r="2"/><circle cx="19" cy="12" r="2"/><path d="m6.8 9 3.4 2M6.8 15l3.4-2M14 12h3"/></svg>
            </span>
            <div><span>INITIAL EXPERIMENT</span><strong>CNN baseline with two classes</strong><p>A custom network used 620 images to validate the workflow. Unstable validation exposed overfitting and the limits of a small dataset.</p></div>
          </li>
          <li>
            <span class="plant-flow-symbol" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="7" width="12" height="12" rx="2"/><path d="m8 7 2-3h10v12l-4 3M7 12h6M10 9v6"/></svg>
            </span>
            <div><span>IMPROVING DATASET</span><strong>Expand and strengthen the training input</strong><p>Multiple public sources were cleaned, reorganised and balanced into a dataset of 5,320 images. Controlled rotations, shifts, zoom and flips then increased variation during training.</p></div>
          </li>
          <li>
            <span class="plant-flow-symbol" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M4 7h10M17 7h3M4 12h3M10 12h10M4 17h8M15 17h5"/><circle cx="15.5" cy="7" r="1.5"/><circle cx="8.5" cy="12" r="1.5"/><circle cx="13.5" cy="17" r="1.5"/></svg>
            </span>
            <div><span>FINE TUNING</span><strong>Adapt VGG16 to the four MRI classes</strong><p>Images were standardised to 224 × 224 × 3. Pretrained visual features were retained while the classification output was adapted to the target classes with roughly 16,000 trainable parameters.</p></div>
          </li>
          <li>
            <span class="plant-flow-symbol" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M4 18V6M4 18h16"/><path d="m7 15 4-4 3 2 5-6"/><path d="M16 7h3v3"/></svg>
            </span>
            <div><span>OUTCOME</span><strong>Stronger recognition through richer learning</strong><p>The larger and more varied input improved model learning, supported more stable generalisation and produced meaningful predictions across four classes.</p></div>
          </li>
        </ol>
      </section>

      <section class="case-section" aria-labelledby="data-title">
        <div class="split-copy">
          <div>
            <p class="case-eyebrow">DATA STRATEGY</p>
            <h2 id="data-title">More data helped. Better controlled data mattered more.</h2>
          </div>
          <div><p>The final experiment used 5,320 MRI images with balanced class counts. A 70/20/10 strategy separated learning, model selection and final evaluation, while augmentation introduced controlled rotations, shifts, zoom and flips exclusively during training.</p></div>
        </div>
        <div class="dataset-bar" aria-label="Dataset distribution">
          <div class="train"><strong>3,720</strong><span>Training · 70%</span></div>
          <div class="validation"><strong>1,080</strong><span>Validation · 20%</span></div>
          <div class="test"><strong>520</strong><span>Test · 10%</span></div>
        </div>
        <figure class="research-figure">
          <button type="button" class="figure-zoom-trigger" data-lightbox-trigger aria-label="Enlarge MRI data augmentation examples">
            <img src="/images/projects/brain-tumour-mri/data-augmentation.png" alt="MRI image and augmented variants used during model training" />
            <span aria-hidden="true">Expand</span>
          </button>
          <figcaption>Controlled augmentation generated new training variants while preserving the original anatomy.</figcaption>
        </figure>
        <section class="dataset-sources" aria-labelledby="sources-title">
          <div>
            <p class="case-eyebrow">OPEN ACADEMIC DATA</p>
            <h3 id="sources-title">Where the MRI images came from.</h3>
            <p>The research combined publicly accessible MRI collections used for academic experimentation. Images from the different sources were reviewed, reorganised and filtered before entering the common training workflow.</p>
          </div>
          <div class="source-links">
            <a class="interactive-control neon-box-control premium-neon-control dataset-source-card" href="https://figshare.com/articles/dataset/brain_tumor_dataset/1512427" target="_blank" rel="noreferrer">
              <span>FIGSHARE</span><strong>Brain Tumor Dataset</strong><small>3,064 T1 weighted MRI images with contrast enhancement across three tumour classes. CC BY 4.0.</small>
              <span class="dataset-source-arrow neon-box-arrow" aria-hidden="true">↗</span>
            </a>
            <a class="interactive-control neon-box-control premium-neon-control dataset-source-card" href="https://www.kaggle.com/datasets/sartajbhuvaji/brain-tumor-classification-mri" target="_blank" rel="noreferrer">
              <span>KAGGLE</span><strong>Brain Tumor Classification (MRI)</strong><small>Public academic collection organised around glioma, meningioma, pituitary and images without a tumour.</small>
              <span class="dataset-source-arrow neon-box-arrow" aria-hidden="true">↗</span>
            </a>
            <a class="interactive-control neon-box-control premium-neon-control dataset-source-card" href="https://github.com/MohamedAliHabib/Brain-Tumor-Detection" target="_blank" rel="noreferrer">
              <span>GITHUB</span><strong>Brain Tumor Detection Dataset</strong><small>Open reference repository containing MRI samples and CNN experimentation material.</small>
              <span class="dataset-source-arrow neon-box-arrow" aria-hidden="true">↗</span>
            </a>
          </div>
        </section>
      </section>

      <section class="case-section" aria-labelledby="results-title">
        <div class="section-heading compact-heading">
          <p class="case-eyebrow">EXPERIMENTAL RESULTS</p>
          <h2 id="results-title">Strong results across classes, with visible room for improvement.</h2>
          <p>The four class model reached 88.17% training accuracy. Evaluation by class showed that glioma remained the most difficult category, reinforcing the importance of visual similarity and dataset quality.</p>
        </div>
        <figure class="benchmark-figure">
          <div class="benchmark-chart" role="group" aria-label="Comparison between target class reference results and the predicted label performance of the applied model">
            <section class="performance-card" aria-labelledby="comparison-chart-title">
              <div class="benchmark-panel-heading">
                <span>COMPARISON BY CLASS</span>
                <strong id="comparison-chart-title">Reference and model accuracy by class</strong>
                <div class="chart-legend" aria-label="Chart legend"><span><i class="target-key"></i>Published target</span><span><i class="predicted-key"></i>Applied model</span></div>
              </div>
              <div class="comparison-plot">
                {[
                  { label: "Meningioma", target: 74.0, predicted: 95.38 },
                  { label: "Glioma", target: 85.7, predicted: 81.54 },
                  { label: "Pituitary", target: 88.4, predicted: 87.66 },
                  { label: "No tumour", target: null, predicted: 93.08 },
                ].map(({ label, target, predicted }) => (
                  <div class:list={["comparison-group", target === null && "has-no-target"]} aria-label={`${label}: ${target === null ? "target benchmark not available" : `target ${target.toFixed(2)} percent`}; predicted ${predicted.toFixed(2)} percent`}>
                    <div class="comparison-row-heading">
                      <strong class="comparison-class">{label}</strong>
                      {target !== null
                        ? <span class:list={["comparison-delta", predicted >= target ? "is-positive" : "is-negative"]}>{predicted >= target ? "+" : ""}{(predicted - target).toFixed(2)} pp</span>
                        : <span class="comparison-delta is-unavailable">Benchmark not available</span>}
                    </div>
                    <div class="paired-bars">
                      <div class:list={["metric-bar-row", target === null && "is-unavailable"]}>
                        <span class="metric-bar-label">Target</span>
                        <span class="metric-bar-track" aria-hidden="true">
                          {target !== null && <span class="metric-bar-fill target-bar" style={`width:${target}%`}></span>}
                        </span>
                        <strong>{target !== null ? `${target.toFixed(2)}%` : "N/A"}</strong>
                      </div>
                      <div class="metric-bar-row">
                        <span class="metric-bar-label">Model</span>
                        <span class="metric-bar-track" aria-hidden="true"><span class="metric-bar-fill model-bar" style={`width:${predicted}%`}></span></span>
                        <strong class="model-value">{predicted.toFixed(2)}%</strong>
                      </div>
                    </div>
                  </div>
                ))}
              </div>
            </section>
          </div>
          <figcaption>
            <strong>Impact of the applied techniques.</strong>
            <span>The model exceeded the reference result for meningioma, remained close for pituitary images and showed a measurable gap for glioma. The no-tumour class reached 93.08%, although no equivalent benchmark was available for a direct comparison.</span>
          </figcaption>
        </figure>
      </section>

      <section class="case-section application-section" aria-labelledby="application-title">
        <div class="split-copy">
          <div>
            <p class="case-eyebrow">FROM MODEL TO PRODUCT</p>
            <h2 id="application-title">From trained model to functional application.</h2>
          </div>
          <div>
            <p>As part of the study, I developed a web application that connected the trained Keras model to a Python and Flask backend. Users could submit an MRI image and receive probabilities across four classes, presented numerically and through D3.js visualisations. This demonstrated how the research model could support a practical review workflow.</p>
            <p class="prediction-study-copy">To demonstrate the complete inference workflow, a pituitary MRI sample was submitted to the application. The report records the selected image, the probability assigned to each class and the final classification returned by the model.</p>
          </div>
        </div>
        <figure class="prediction-report">
          <button type="button" class="figure-zoom-trigger prediction-report-image" data-lightbox-trigger aria-label="Enlarge pituitary tumour MRI input">
            <img src="/images/projects/brain-tumour-mri/class-pituitary.png" alt="Pituitary tumour MRI selected as input for prediction across four classes" />
            <span aria-hidden="true">Expand</span>
          </button>
          <pre aria-label="Prediction report covering four classes">========================================
MRI CLASSIFICATION REPORT
========================================

INPUT DATA
FILE............. pituitary (654).png
INPUT TYPE....... MRI IMAGE
MODEL OUTPUT..... FOUR CLASSES

PREDICTION SCORES
MENINGIOMA....... 0.007176
NO TUMOUR........ 0.000283
GLIOMA........... 0.051178
PITUITARY........ 0.941363

PRIMARY CLASSIFICATION
LABEL............ PITUITARY
CONFIDENCE....... 94.1363%

REPORT STATUS.... COMPLETE
END OF REPORT
========================================</pre>
          <figcaption>Pituitary MRI input and the four probability values returned by the trained model.</figcaption>
        </figure>
        <figure class="prediction-distribution" aria-labelledby="prediction-distribution-title">
          <p class="prediction-chart-kicker" id="prediction-distribution-title">PREDICTION DISTRIBUTION</p>

          <div class="prediction-donut-wrap">
            <svg class="prediction-donut" viewBox="0 0 120 120" role="img" aria-labelledby="prediction-donut-title prediction-donut-desc">
              <title id="prediction-donut-title">Prediction probability distribution</title>
              <desc id="prediction-donut-desc">Pituitary 94.1363 percent, glioma 5.1178 percent, meningioma 0.7176 percent and no tumour 0.0283 percent.</desc>
              <defs>
                <pattern id="pie-dot-grid" width="4" height="4" patternUnits="userSpaceOnUse">
                  <circle cx="0.8" cy="0.8" r="0.28" fill="rgba(221, 214, 254, 0.58)"></circle>
                </pattern>
                {predictionPie.map((slice, index) => (
                  <clipPath id={`pie-clip-${index}`}>
                    <path d={slice.path}></path>
                  </clipPath>
                ))}
              </defs>
              <g class="pie-depth" aria-hidden="true">
                {predictionPie.map((slice) => (
                  <g transform={slice.transform}>
                    <path class:list={["pie-slice-depth", slice.className]} d={slice.path} transform="translate(0 22)"></path>
                    <path class:list={["pie-depth-edges", slice.className]} d={slice.edgePath}></path>
                  </g>
                ))}
              </g>
              <g class="pie-surfaces">
                {predictionPie.map((slice, index) => (
                  <g transform={slice.transform}>
