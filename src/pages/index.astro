---
import { Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import Container from "../components/common/Container.astro";
import Section from "../components/common/Section.astro";
import Button from "../components/ui/Button.astro";
import heroBackground from "../assets/hero-systems-geometry-v1.png";
import AboutSection from "../components/sections/AboutSection.astro";
import PortfolioSection from "../components/sections/PortfolioSection.astro";
import experienceBackground from "../assets/experience-system-architecture-v1.png";
import projectsBackground from "../assets/projects-integration-v1.png";
import internationalBackground from "../assets/international-perspective-v1.png";
import researchBackground from "../assets/research-neural-architecture-v1.png";
import ContactSection from "../components/sections/ContactSection.astro";
---

<BaseLayout
  title="Diego Carrillo | Systems Engineer"
>

<Section class="relative isolate flex min-h-[calc(100svh-5rem)] items-center overflow-hidden py-20">

<Image
  src={heroBackground}
  alt=""
  aria-hidden="true"
  loading="eager"
  class="absolute inset-0 -z-20 h-full w-full object-cover object-center"
/>

<div
  aria-hidden="true"
  class="absolute inset-0 -z-10 bg-[linear-gradient(90deg,rgba(3,7,12,0.94)_0%,rgba(3,7,12,0.82)_40%,rgba(3,7,12,0.44)_72%,rgba(3,7,12,0.2)_100%)]"
/>

<div
  aria-hidden="true"
  class="absolute inset-0 -z-10 bg-[linear-gradient(0deg,rgba(3,7,12,0.82)_0%,transparent_48%)]"
/>

<Container>

<h1
class="text-5xl font-bold"
>

Engineering complex systems.

</h1>

<p
class="mt-6 max-w-2xl text-lg text-slate-400"
>

Multidisciplinary engineer specialized in industrial automation,
SCADA platforms, renewable energy integration and resilient power systems.

</p>

<div class="mt-10 flex gap-4">

<Button href="#projects">

View Engineering Work

</Button>

</div>

</Container>

</Section>

<AboutSection />

<PortfolioSection
  id="experience"
  eyebrow="EXPERIENCE"
  title="Engineering across critical energy systems."
  description="A foundation in automation, control and infrastructure for complex industrial environments."
  background={experienceBackground}
/>

<PortfolioSection
  id="projects"
  eyebrow="PROJECTS"
  title="Systems designed for operational confidence."
  description="Selected work across power systems, industrial integration and resilient control environments."
  background={projectsBackground}
/>

<PortfolioSection
  id="perspective"
  eyebrow="INTERNATIONAL PERSPECTIVE"
  title="Engineering shaped across borders."
  description="Academic and professional experience across countries, cultures and multidisciplinary technical environments — complemented by international technology competitions."
  background={internationalBackground}
/>

<PortfolioSection
  id="research"
  eyebrow="RESEARCH & RECOGNITION"
  title="Deep learning applied to medical image classification."
  description="My postgraduate thesis investigated convolutional neural networks for classifying brain tumours from magnetic resonance images. The research earned a final grade of 10/10 and reflects a continuing interest in rigorous, applied machine learning."
  background={researchBackground}
/>

<ContactSection />

</BaseLayout>
