---
import BaseLayout from "../layouts/BaseLayout.astro";
import AboutSection from "../components/sections/AboutSection.astro";
import PortfolioSection from "../components/sections/PortfolioSection.astro";
import ContactSection from "../components/sections/ContactSection.astro";
import AboutDestinationIcon from "../components/common/AboutDestinationIcon.astro";
import ArrowIcon from "../components/common/ArrowIcon.astro";
import { projects } from "../data/projects";
---

<BaseLayout title="Diego Carrillo | Systems Engineer">
  <AboutSection />

  <PortfolioSection
    id="projects"
    eyebrow="PROJECTS"
    title="Systems designed for operational confidence."
    description="Selected work across power systems, industrial integration and resilient control environments."
  >
    <div class="mt-12 flex max-w-xl flex-col gap-3 text-sm text-violet-100">
      {projects.map((project) => (
        <a
          href={`/projects/${project.slug}`}
          aria-label={`Open project, ${project.title}`}
          class="interactive-control neon-box-control premium-neon-control project-link"
        >
          <span class="neon-box-label">{project.shortLabel}</span>
          <ArrowIcon />
        </a>
      ))}
    </div>
  </PortfolioSection>

  <PortfolioSection
    id="milestones"
    eyebrow="MILESTONES"
    title="Technical milestones and recognition."
    description="Selected academic work, international technology competitions and personal milestones that complement my professional engineering practice."
  >
    <div class="mt-12 flex max-w-xl flex-col gap-3 text-sm text-violet-100" aria-label="Milestone entries">
      <a
        href="/milestones/hardwarethon/"
        aria-label="Explore Hardwarethon Costa Rica 2019"
        class="interactive-control neon-box-control premium-neon-control project-link"
      >
        <span class="neon-box-symbol"><AboutDestinationIcon icon="trophy" /></span>
        <span class="neon-box-label">Hardwarethon 2019</span>
        <ArrowIcon />
      </a>
    </div>
  </PortfolioSection>

  <ContactSection />
</BaseLayout>
