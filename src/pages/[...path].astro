---
import { projects } from "../data/projects";
import { imageLibrary } from "../data/image-library";
import BaseLayout from "../layouts/BaseLayout.astro";
import FloatingBackControl from "../components/common/FloatingBackControl.astro";
import ArrowIcon from "../components/common/ArrowIcon.astro";
import { localizeProject, translateProjectText } from "../i18n/projects";

export function getStaticPaths() {
  return projects.flatMap((project) => [
    { params: { path: `projects/${project.slug}` }, props: { project, locale: "en" } },
    { params: { path: `nl/projects/${project.slug}` }, props: { project, locale: "nl" } },
    { params: { path: `de/projects/${project.slug}` }, props: { project, locale: "de" } },
    { params: { path: `fr/projects/${project.slug}` }, props: { project, locale: "fr" } },
  ]);
}

const { project, locale = "en" } = Astro.props;
const isFrench = locale === "fr";
const isDutch = locale === "nl";
const isGerman = locale === "de";
const tr = (text: string) => translateProjectText(text, locale);
const homePath = locale === "en" ? "/" : `/${locale}/`;
const localizedProject = localizeProject(project, locale);
const isResearchCaseStudy = project.slug === "brain-tumour-mri-classification";
const isGridStabilityCaseStudy = project.slug === "grid-contingency-analysis";
const isRenewableControlCaseStudy = project.slug === "renewable-plant-control";
const isTelecomCoverageCaseStudy = project.slug === "telecommunications-coverage-deployment";
---

<BaseLayout locale={locale} title={`${localizedProject.title} | Diego Carrillo`} description={localizedProject.summary}>
  {isResearchCaseStudy ? (
    <main class="case-study">
      <section class="case-hero">
        <FloatingBackControl href={`${homePath}#projects`} label={tr("Back to projects")} />

        <div class="case-hero-grid">
          <div class="case-hero-copy">
            <p class="case-eyebrow">{tr("MASTER'S RESEARCH · COMPUTER VISION")}</p>
            <h1>{tr("Classifying brain tumours from MRI.")}</h1>
            <p class="case-lead">{tr("A research prototype that classifies varied medical images into four categories using a convolutional model and a web interface.")}</p>
            <a href="/documents/master-thesis-brain-tumour-mri.pdf" class="report-access-control" data-report-open>
              <span>{tr("Explore report")}</span>
              <svg viewBox="0 0 18 18" aria-hidden="true"><path d="M5 13 13 5M7 5h6v6" /></svg>
            </a>
          </div>

          <figure class="hero-visual">
            <div class="scan-frame">
              <button type="button" class="figure-zoom-trigger" data-lightbox-trigger aria-label={tr("Enlarge preprocessed MRI samples")}>
                <img src={imageLibrary.projects.brainTumourMri.preprocessing.dark.desktop} alt={tr("Preprocessed MRI samples showing brain images with and without tumours")} />
                <span aria-hidden="true">{tr("Expand")}</span>
              </button>
              <div class="scan-line" aria-hidden="true"></div>
            </div>
            <figcaption>{tr("Preprocessed MRI samples from the experimental workflow.")}</figcaption>
          </figure>
        </div>

        <section class="interactive-model" aria-labelledby="interactive-model-title">
          <div class="interactive-model-heading">
            <div>
              <p class="case-eyebrow">{tr("INTERACTIVE 3D")}</p>
              <h2 id="interactive-model-title">{tr("Explore the tumour model.")}</h2>
            </div>
            <div class="interactive-model-controls" aria-label={tr("Interactive model controls")}>
              <button type="button" data-second-model-reset disabled>{tr("Reset View")}</button>
              <button type="button" data-second-tumour-toggle aria-pressed="true" disabled>{tr("Hide Tumor")}</button>
            </div>
          </div>
          <div class="interactive-model-frame">
            <iframe
              data-second-sketchfab-viewer
              title="3D Brain Tumor Model"
              allow="autoplay; fullscreen; xr-spatial-tracking"
              allowfullscreen
            ></iframe>
          </div>
          <div class="interactive-model-meta">
            <span>{tr("Drag to rotate · scroll or pinch to zoom")}</span>
            <span>{isFrench ? "3D Brain Tumor Model, par Rafael G. Malanga sur Sketchfab." : "3D Brain Tumor Model by Rafael G. Malanga on Sketchfab."}</span>
          </div>
          <div class="interactive-model-variant">
            <div class="interactive-model-heading">
              <div class="interactive-model-controls" aria-label={tr("Second interactive model controls")}>
                <button type="button" data-model-reset disabled>{tr("Reset View")}</button>
                <button type="button" data-tumour-toggle aria-pressed="true" disabled>{tr("Hide Tumor")}</button>
                <button type="button" data-tags-toggle aria-pressed="true" disabled>{tr("Hide Tags")}</button>
              </div>
            </div>
            <div class="interactive-model-frame">
              <iframe data-sketchfab-viewer title="CT Skull and Brain, with Tumor" allow="autoplay; fullscreen; xr-spatial-tracking" allowfullscreen></iframe>
            </div>
            <div class="interactive-model-meta">
              <span>{tr("Drag to rotate · scroll or pinch to zoom")}</span>
              <span>{isFrench ? "CT Skull and Brain, with Tumor, par AlorE sur Sketchfab." : isDutch ? "CT Skull and Brain, with Tumor van AlorE op Sketchfab." : isGerman ? "CT Skull and Brain, with Tumor von AlorE auf Sketchfab." : "CT Skull and Brain, with Tumor by AlorE on Sketchfab."}</span>
            </div>
          </div>
          <div class="interactive-model-variant" data-additional-model="3ca52ce84c94458ba0357fa7bfeb5cd8">
            <div class="interactive-model-heading">
              <div class="interactive-model-controls" aria-label={isFrench ? "Commandes du troisième modèle interactif" : isDutch ? "Bediening van het derde interactieve model" : isGerman ? "Steuerung des dritten interaktiven Modells" : "Third interactive model controls"}>
                <button type="button" data-additional-model-reset disabled>{tr("Reset View")}</button>
                <button type="button" data-additional-tumour-toggle aria-pressed="true" disabled>{tr("Hide Tumor")}</button>
              </div>
            </div>
            <div class="interactive-model-frame">
              <iframe data-additional-sketchfab-viewer title="1D: 3D Model of a CT Brain with Tumor, Cronin" allow="autoplay; fullscreen; xr-spatial-tracking" allowfullscreen></iframe>
            </div>
            <div class="interactive-model-meta">
              <span>{tr("Drag to rotate · scroll or pinch to zoom")}</span>
              <span>1D: 3D Model of a CT Brain with Tumor, Cronin — jamiecronin, Sketchfab.</span>
            </div>
          </div>
        </section>
        <script is:inline src="https://static.sketchfab.com/api/sketchfab-viewer-1.12.1.js"></script>
      </section>

      <section class="case-section impact-section" aria-labelledby="impact-title">
        <div class="section-heading">
          <p class="case-eyebrow">{tr("WHY IT MATTERS")}</p>
          <h2 id="impact-title">{tr("A difficult visual problem with real clinical consequences.")}</h2>
          <p>{tr("Brain and central nervous system tumours are less common than many cancers, but their location and varied appearance make assessment difficult. This project explored how computer vision could support image review without replacing clinical judgement.")}</p>
        </div>
        <div class="metric-grid">
          <article><strong>321,731</strong><span>{tr("New brain and CNS cancer cases worldwide in 2022")}</span></article>
          <article><strong>248,500</strong><span>{tr("Estimated deaths worldwide in 2022")}</span></article>
          <article><strong>{tr("4 Classes")}</strong><span>{tr("Meningioma, glioma, pituitary and no tumour")}</span></article>
        </div>
        <p class="source-note">{isFrench ? "Contexte mondial" : isDutch ? "Wereldwijde context" : isGerman ? "Globaler Kontext" : "Global context"}: <a href="https://gco.iarc.who.int/media/globocan/factsheets/cancers/31-brain-central-nervous-system-fact-sheet.pdf" target="_blank" rel="noreferrer">IARC Global Cancer Observatory, GLOBOCAN 2022</a>. {tr("The prototype is research work and is not a validated medical diagnostic device.")}</p>
      </section>

      <section class="case-section" aria-labelledby="challenge-title">
        <div class="split-copy">
          <div>
            <p class="case-eyebrow">{tr("THE CHALLENGE")}</p>
            <h2 id="challenge-title">{tr("Teaching a model to distinguish visually similar patterns.")}</h2>
          </div>
          <div>
            <p>{tr("MRI datasets vary in resolution, anatomical view and acquisition conditions. Tumours can also look similar in location, shape and texture, making the classes difficult to separate.")}</p>
            <p>{tr("Data quality and a sound experimental method mattered as much as model architecture. Public datasets were combined and balanced, low-quality images removed, and augmentation kept separate from the test set.")}</p>
          </div>
        </div>
        <div class="class-grid" aria-label={tr("Classification targets")}>
          {[
            { title: tr("Meningioma").toLocaleUpperCase(locale), copy: tr("Tumour arising from the meninges surrounding the brain."), image: imageLibrary.projects.brainTumourMri.classMeningioma.dark.desktop },
            { title: tr("Glioma").toLocaleUpperCase(locale), copy: tr("Tumour originating in glial cells, with highly variable appearance."), image: imageLibrary.projects.brainTumourMri.classGlioma.dark.desktop },
            { title: tr("Pituitary tumour").toLocaleUpperCase(locale), copy: tr("Tumour located around the pituitary gland at the base of the brain."), image: imageLibrary.projects.brainTumourMri.classPituitary.dark.desktop },
            { title: isFrench ? "ABSENCE DE TUMEUR" : isDutch ? "GEEN TUMOR" : isGerman ? "KEIN TUMOR" : "NO TUMOUR", copy: tr("MRI samples without evidence of the three target tumour classes."), image: imageLibrary.projects.brainTumourMri.classNoTumour.dark.desktop },
          ].map(({ title, copy, image }) => (
            <article>
              <button type="button" class="figure-zoom-trigger class-image-trigger" data-lightbox-trigger aria-label={isFrench ? `Agrandir l’IRM de la classe ${title.toLowerCase()}` : isDutch ? `MRI-voorbeeld vergroten, geclassificeerd als ${title.toLowerCase()}` : isGerman ? `Als ${title.toLowerCase()} klassifiziertes MRT-Beispiel vergrößern` : `Enlarge MRI example classified as ${title.toLowerCase()}`}>
                <img src={image} alt={isFrench ? `Exemple d’IRM de la classe ${title.toLowerCase()}` : isDutch ? `MRI-voorbeeld geclassificeerd als ${title.toLowerCase()}` : isGerman ? `Als ${title.toLowerCase()} klassifiziertes MRT-Beispiel` : `MRI example classified as ${title.toLowerCase()}`} />
                <span aria-hidden="true">{tr("Expand")}</span>
              </button>
              <div><h3>{title}</h3><p>{copy}</p></div>
            </article>
          ))}
        </div>
      </section>

      <section class="case-section" aria-labelledby="pipeline-title">
        <div class="section-heading compact-heading">
          <p class="case-eyebrow">{tr("RESEARCH PIPELINE")}</p>
          <h2 id="pipeline-title">{tr("From raw images to an interpretable prediction.")}</h2>
        </div>
        <ol class="plant-flow" aria-label={tr("MRI research workflow")}>
          <li>
            <span class="plant-flow-symbol" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M6 2h8l4 4v16H6V2Z"/><path d="M14 2v5h5M9 11h6M9 15h6M9 19h4"/></svg>
            </span>
            <div><span>{tr("DATA")}</span><strong>{tr("Prepare the MRI dataset")}</strong><p>{tr("Combine public collections, remove unsuitable samples and separate training, validation and test data.")}</p></div>
          </li>
          <li>
            <span class="plant-flow-symbol" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="16" rx="2"/><path d="M3 8h18M7 6h.01M10 6h.01M8.5 12.5 6 15l2.5 2.5M15.5 12.5 18 15l-2.5 2.5M13.5 11.5l-3 7"/></svg>
            </span>
            <div><span>{tr("MODEL")}</span><strong>{tr("Train through transfer learning")}</strong><p>{tr("Use controlled augmentation and adapt VGG16 visual features to distinguish the four MRI classes.")}</p></div>
          </li>
          <li>
            <span class="plant-flow-symbol" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="13" rx="2"/><path d="M7 13V9M11 13V7M15 13v-3M19 13V6M9 21h6M12 17v4"/></svg>
            </span>
            <div><span>{tr("OUTPUT")}</span><strong>{tr("Evaluate and deliver predictions")}</strong><p>{tr("Assess every class and serve probabilities through a Flask application with numerical and visual results.")}</p></div>
          </li>
        </ol>
      </section>

      <section class="case-section visual-story" aria-labelledby="model-title">
        <div class="split-copy">
          <div>
            <p class="case-eyebrow">{tr("MODEL EVOLUTION")}</p>
            <h2 id="model-title">{tr("The first model revealed the problem. VGG16 made it scalable.")}</h2>
          </div>
          <div>
            <p>{tr("An initial two-class CNN established the preprocessing and evaluation steps. Validation was unstable with the small dataset. More data and better cleaning improved the experiment before it expanded to four classes.")}</p>
            <p>{tr("Transfer learning reused VGG16’s pretrained visual features. Most layers were frozen and the output adapted, leaving roughly 16,000 trainable parameters for the classification task.")}</p>
          </div>
        </div>
        <figure class="research-figure wide-figure vgg16-figure">
          <button type="button" class="figure-zoom-trigger" data-lightbox-trigger aria-label={tr("Enlarge VGG16 architecture diagram")}>
            <img class="vgg16-theme-image vgg16-theme-image--dark" data-theme-image="dark" src={imageLibrary.projects.brainTumourMri.vgg16.dark.desktop} alt={tr("VGG16 transfer learning architecture used for MRI classification across four classes")} />
            <img class="vgg16-theme-image vgg16-theme-image--light" data-theme-image="light" src={imageLibrary.projects.brainTumourMri.vgg16.light.desktop} alt={tr("VGG16 transfer learning architecture used for MRI classification across four classes")} />
            <span aria-hidden="true">{tr("Expand")}</span>
          </button>
          <figcaption>{tr("VGG16 transfer learning architecture adapted during the research.")}</figcaption>
        </figure>
        <ol class="plant-flow" aria-label={tr("MRI model evolution")}>
          <li>
            <span class="plant-flow-symbol" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="5" cy="8" r="2"/><circle cx="5" cy="16" r="2"/><circle cx="12" cy="12" r="2"/><circle cx="19" cy="12" r="2"/><path d="m6.8 9 3.4 2M6.8 15l3.4-2M14 12h3"/></svg>
            </span>
            <div><span>{tr("INITIAL EXPERIMENT")}</span><strong>{tr("CNN baseline with two classes")}</strong><p>{tr("A custom network used 620 images to validate the workflow. Unstable validation exposed overfitting and the limits of a small dataset.")}</p></div>
          </li>
          <li>
            <span class="plant-flow-symbol" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="7" width="12" height="12" rx="2"/><path d="m8 7 2-3h10v12l-4 3M7 12h6M10 9v6"/></svg>
            </span>
            <div><span>{tr("IMPROVING DATASET")}</span><strong>{tr("Expand and strengthen the training input")}</strong><p>{tr("Public sources were cleaned, reorganised and balanced into 5,320 images. Controlled rotations, shifts, zooms and flips added variety during training.")}</p></div>
          </li>
          <li>
            <span class="plant-flow-symbol" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M4 7h10M17 7h3M4 12h3M10 12h10M4 17h8M15 17h5"/><circle cx="15.5" cy="7" r="1.5"/><circle cx="8.5" cy="12" r="1.5"/><circle cx="13.5" cy="17" r="1.5"/></svg>
            </span>
            <div><span>{tr("FINE TUNING")}</span><strong>{tr("Adapt VGG16 to the four MRI classes")}</strong><p>{tr("Images were standardised to 224 × 224 × 3. VGG16’s pretrained features were retained, while roughly 16,000 trainable parameters adapted the output to four classes.")}</p></div>
          </li>
          <li>
            <span class="plant-flow-symbol" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M4 18V6M4 18h16"/><path d="m7 15 4-4 3 2 5-6"/><path d="M16 7h3v3"/></svg>
            </span>
            <div><span>{tr("OUTCOME")}</span><strong>{tr("Stronger recognition through richer learning")}</strong><p>{tr("The larger and more varied input improved model learning, supported more stable generalisation and produced meaningful predictions across four classes.")}</p></div>
          </li>
        </ol>
      </section>

      <section class="case-section" aria-labelledby="data-title">
        <div class="split-copy">
          <div>
            <p class="case-eyebrow">{tr("DATA STRATEGY")}</p>
            <h2 id="data-title">{tr("Better data made the difference.")}</h2>
          </div>
          <div><p>{tr("The final dataset contained 5,320 MRI images with balanced classes. A 70/20/10 split separated training, validation and testing. Controlled rotations, shifts, zooms and flips were applied only during training.")}</p></div>
        </div>
        <div class="dataset-bar" aria-label={tr("Dataset distribution")}>
          <div class="train"><strong>3,720</strong><span>{tr("Training · 70%")}</span></div>
          <div class="validation"><strong>1,080</strong><span>{tr("Validation · 20%")}</span></div>
          <div class="test"><strong>520</strong><span>{tr("Test · 10%")}</span></div>
        </div>
        <figure class="research-figure augmentation-figure">
          <button type="button" class="figure-zoom-trigger" data-lightbox-trigger aria-label={tr("Enlarge MRI data augmentation examples")}>
            <img src={imageLibrary.projects.brainTumourMri.dataAugmentation.dark.desktop} alt={tr("MRI image and augmented variants used during model training")} />
            <span aria-hidden="true">{tr("Expand")}</span>
          </button>
          <figcaption>{tr("Controlled augmentation generated new training variants while preserving the original anatomy.")}</figcaption>
        </figure>
        <section class="dataset-sources" aria-labelledby="sources-title">
          <div>
            <p class="case-eyebrow">{tr("OPEN ACADEMIC DATA")}</p>
            <h3 id="sources-title">{tr("Where the MRI images came from.")}</h3>
            <p>{tr("The study combined public MRI collections for academic research. Images were reviewed, reorganised and filtered before entering a shared training process.")}</p>
          </div>
          <div class="source-links">
            <a class="interactive-control neon-box-control premium-neon-control dataset-source-card" href="https://figshare.com/articles/dataset/brain_tumor_dataset/1512427" target="_blank" rel="noreferrer">
              <span>FIGSHARE</span><strong>Brain Tumor Dataset</strong><small>{tr("3,064 T1 weighted MRI images with contrast enhancement across three tumour classes. CC BY 4.0.")}</small>
              <ArrowIcon class="dataset-source-arrow" />
            </a>
            <a class="interactive-control neon-box-control premium-neon-control dataset-source-card" href="https://www.kaggle.com/datasets/sartajbhuvaji/brain-tumor-classification-mri" target="_blank" rel="noreferrer">
              <span>KAGGLE</span><strong>Brain Tumor Classification (MRI)</strong><small>{tr("Public academic collection organised around glioma, meningioma, pituitary and images without a tumour.")}</small>
              <ArrowIcon class="dataset-source-arrow" />
            </a>
            <a class="interactive-control neon-box-control premium-neon-control dataset-source-card" href="https://github.com/MohamedAliHabib/Brain-Tumor-Detection" target="_blank" rel="noreferrer">
              <span>GITHUB</span><strong>Brain Tumor Detection Dataset</strong><small>{tr("Open reference repository containing MRI samples and CNN experimentation material.")}</small>
              <ArrowIcon class="dataset-source-arrow" />
            </a>
          </div>
        </section>
      </section>

      <section class="case-section" aria-labelledby="results-title">
        <div class="section-heading compact-heading">
          <p class="case-eyebrow">{tr("EXPERIMENTAL RESULTS")}</p>
          <h2 id="results-title">{tr("Strong results across classes, with visible room for improvement.")}</h2>
          <p>{tr("The four-class model achieved 88.17% training accuracy. Glioma remained the hardest class to identify, highlighting the effects of visual similarity and data quality.")}</p>
        </div>
        <figure class="benchmark-figure">
          <div class="benchmark-chart" role="group" aria-label={tr("Comparison between target class reference results and the predicted label performance of the applied model")}>
            <section class="performance-card" aria-labelledby="comparison-chart-title">
              <div class="benchmark-panel-heading">
                <span>{tr("COMPARISON BY CLASS")}</span>
                <strong id="comparison-chart-title">{tr("Reference and model accuracy by class")}</strong>
                <div class="chart-legend" aria-label={tr("Chart legend")}><span><i class="target-key"></i>{tr("Published target")}</span><span><i class="predicted-key"></i>{tr("Applied model")}</span></div>
              </div>
              <div class="comparison-plot">
                {[
                  { label: tr("Meningioma"), target: 74.0, predicted: 95.38 },
                  { label: tr("Glioma"), target: 85.7, predicted: 81.54 },
                  { label: tr("Pituitary tumour"), target: 88.4, predicted: 87.66 },
                  { label: tr("No tumour"), target: null, predicted: 93.08 },
                ].map(({ label, target, predicted }) => (
                  <div class:list={["comparison-group", target === null && "has-no-target"]} aria-label={isFrench ? `${label} : ${target === null ? "référence indisponible" : `référence ${target.toFixed(2).replace(".", ",")} %`} ; prédiction ${predicted.toFixed(2).replace(".", ",")} %` : isDutch ? `${label}: ${target === null ? "geen referentiebenchmark beschikbaar" : `referentie ${target.toFixed(2)} procent`}; voorspeld ${predicted.toFixed(2)} procent` : isGerman ? `${label}: ${target === null ? "keine Referenzbenchmark verfügbar" : `Referenz ${target.toFixed(2)} Prozent`}; prognostiziert ${predicted.toFixed(2)} Prozent` : `${label}: ${target === null ? "target benchmark not available" : `target ${target.toFixed(2)} percent`}; predicted ${predicted.toFixed(2)} percent`}>
                    <div class="comparison-row-heading">
                      <strong class="comparison-class">{label}</strong>
                      {target !== null
                        ? <span class:list={["comparison-delta", predicted >= target ? "is-positive" : "is-negative"]}>{predicted >= target ? "+" : ""}{(predicted - target).toFixed(2)} pp</span>
                        : <span class="comparison-delta is-unavailable">{tr("Benchmark not available")}</span>}
                    </div>
                    <div class="paired-bars">
                      <div class:list={["metric-bar-row", target === null && "is-unavailable"]}>
                        <span class="metric-bar-label">{tr("Target")}</span>
                        <span class="metric-bar-track" aria-hidden="true">
                          {target !== null && <span class="metric-bar-fill target-bar" style={`width:${target}%`}></span>}
                        </span>
                        <strong>{target !== null ? `${target.toFixed(2)}%` : "N/A"}</strong>
                      </div>
                      <div class="metric-bar-row">
                        <span class="metric-bar-label">{isFrench ? "Modèle" : isGerman ? "Modell" : "Model"}</span>
                        <span class="metric-bar-track" aria-hidden="true"><span class="metric-bar-fill model-bar" style={`width:${predicted}%`}></span></span>
                        <strong class="model-value">{predicted.toFixed(2)}%</strong>
                      </div>
                    </div>
                  </div>
                ))}
              </div>
            </section>
          </div>
          <figcaption>
            <strong>{tr("Impact of the applied techniques.")}</strong>
            <span>{tr("The model exceeded the meningioma reference, came close for pituitary tumours and fell short for glioma. The no-tumour class reached 93.08%, with no equivalent reference for a direct comparison.")}</span>
          </figcaption>
        </figure>
      </section>

      <section class="case-section application-section" aria-labelledby="application-title">
        <div class="split-copy">
          <div>
            <p class="case-eyebrow">{tr("FROM MODEL TO PRODUCT")}</p>
            <h2 id="application-title">{tr("From trained model to functional application.")}</h2>
          </div>
          <div>
            <p>{tr("I built a web application linking the trained Keras model to a Python and Flask backend. Users could submit an MRI image and view four class probabilities as numbers and D3.js charts, demonstrating a practical research workflow.")}</p>
            <p class="prediction-study-copy">{tr("A pituitary tumour MRI demonstrates the complete inference process. The report shows the input image, each class probability and the model’s final classification.")}</p>
          </div>
        </div>
        <figure class="prediction-report">
          <button type="button" class="figure-zoom-trigger prediction-report-image" data-lightbox-trigger aria-label={tr("Enlarge pituitary tumour MRI input")}>
            <img src={imageLibrary.projects.brainTumourMri.classPituitary.dark.desktop} alt={tr("Pituitary tumour MRI selected as input for prediction across four classes")} />
            <span aria-hidden="true">{tr("Expand")}</span>
          </button>
          <pre aria-label={tr("Prediction report covering four classes")}>{isFrench ? `========================================
RAPPORT DE CLASSIFICATION D’IRM
========================================

DONNÉES D’ENTRÉE
FICHIER.......... pituitary (654).png
