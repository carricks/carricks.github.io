<script>
  const isFrenchDocument = document.documentElement.lang === "fr";
  const isDutchDocument = document.documentElement.lang === "nl";
  const isGermanDocument = document.documentElement.lang === "de";
  const zoomTriggers = document.querySelectorAll<HTMLButtonElement>("[data-lightbox-trigger]");
  const lightbox = document.querySelector<HTMLDialogElement>("[data-figure-lightbox]");
  const closeButton = document.querySelector<HTMLButtonElement>("[data-figure-close]");
  const lightboxImage = document.querySelector<HTMLImageElement>("[data-lightbox-image]");
  let activeTrigger: HTMLButtonElement | null = null;

  const closeLightbox = () => {
    if (!lightbox?.open) return;
    lightbox.close();
  };

  zoomTriggers.forEach((trigger) => {
    trigger.addEventListener("click", () => {
      const activeTheme = document.documentElement.dataset.theme === "light" ? "light" : "dark";
      const sourceImage = trigger.querySelector<HTMLImageElement>(`img[data-theme-image="${activeTheme}"]`) ?? trigger.querySelector<HTMLImageElement>("img");
      if (!lightbox || !lightboxImage || !sourceImage) return;
      const sourceStyles = getComputedStyle(sourceImage);
      activeTrigger = trigger;
      lightboxImage.src = sourceImage.currentSrc || sourceImage.src;
      lightboxImage.alt = isFrenchDocument ? `Vue agrandie : ${sourceImage.alt}` : isDutchDocument ? `Vergroot: ${sourceImage.alt}` : isGermanDocument ? `Vergrößert: ${sourceImage.alt}` : `Expanded ${sourceImage.alt}`;
      lightboxImage.style.filter = sourceStyles.filter;
      lightboxImage.style.mixBlendMode = sourceStyles.mixBlendMode;
      lightboxImage.style.opacity = sourceStyles.opacity;
      lightboxImage.style.setProperty("mask-image", sourceStyles.getPropertyValue("mask-image"));
      lightboxImage.style.setProperty("mask-mode", sourceStyles.getPropertyValue("mask-mode"));
      lightboxImage.style.setProperty("mask-position", sourceStyles.getPropertyValue("mask-position"));
      lightboxImage.style.setProperty("mask-repeat", sourceStyles.getPropertyValue("mask-repeat"));
      lightboxImage.style.setProperty("mask-size", sourceStyles.getPropertyValue("mask-size"));
      lightboxImage.style.setProperty("-webkit-mask-image", sourceStyles.getPropertyValue("-webkit-mask-image"));
      lightbox.dataset.theme = activeTheme;
      lightboxImage.style.backgroundColor = activeTheme === "light" ? "#f1eef5" : "#020203";
      lightbox.setAttribute("aria-label", lightboxImage.alt);
      lightbox.showModal();
    });
  });
  closeButton?.addEventListener("click", closeLightbox);
  lightbox?.addEventListener("close", () => activeTrigger?.focus());
  lightbox?.addEventListener("click", (event) => {
    if (event.target === lightbox) closeLightbox();
  });

  const reportTrigger = document.querySelector<HTMLAnchorElement>("[data-report-open]");
  const reportViewer = document.querySelector<HTMLDialogElement>("[data-report-viewer]");
  const reportFrame = document.querySelector<HTMLIFrameElement>("[data-report-frame]");
  const reportClose = document.querySelector<HTMLButtonElement>("[data-report-close]");

  const closeReport = () => {
    if (!reportViewer?.open) return;
    reportViewer.close();
  };

  reportTrigger?.addEventListener("click", (event) => {
    if (!reportViewer || !reportFrame) return;
    event.preventDefault();
    reportFrame.src = reportFrame.dataset.source ?? reportTrigger.href;
    reportViewer.showModal();
  });
  reportClose?.addEventListener("click", closeReport);
  reportViewer?.addEventListener("click", (event) => {
    if (event.target === reportViewer) closeReport();
  });
  reportViewer?.addEventListener("close", () => {
    if (reportFrame) reportFrame.removeAttribute("src");
    reportTrigger?.focus();
  });

  if (document.querySelector(".case-study")) {
    let scrollEffectTimer: number | undefined;
    const updateScrollEffect = () => {
      document.documentElement.classList.add("case-is-scrolling");
      window.clearTimeout(scrollEffectTimer);
      scrollEffectTimer = window.setTimeout(() => document.documentElement.classList.remove("case-is-scrolling"), 150);
    };

    window.addEventListener("scroll", updateScrollEffect, { passive: true });
  }

  const sketchfabFrame = document.querySelector<HTMLIFrameElement>("[data-sketchfab-viewer]");
  const modelReset = document.querySelector<HTMLButtonElement>("[data-model-reset]");
  const tumourToggle = document.querySelector<HTMLButtonElement>("[data-tumour-toggle]");
  const tagsToggle = document.querySelector<HTMLButtonElement>("[data-tags-toggle]");
  const SketchfabViewer = (window as typeof window & { Sketchfab?: new (version: string, frame: HTMLIFrameElement) => any }).Sketchfab;

  const modelApis: any[] = [];
  const syncModelBackgrounds = () => {
    const color = document.documentElement.dataset.theme === "light"
      ? [241 / 255, 238 / 255, 245 / 255] : [0, 0, 0];
    modelApis.forEach((api) => api.setBackground({ color }));
  };
  const registerModelBackground = (api: any) => {
    modelApis.push(api);
    syncModelBackgrounds();
  };
  new MutationObserver(syncModelBackgrounds).observe(document.documentElement, {
    attributes: true, attributeFilter: ["data-theme"],
  });

  if (sketchfabFrame && SketchfabViewer) {
    const client = new SketchfabViewer("1.12.1", sketchfabFrame);
    client.init("df80f6027970411d8446af01fcb76b1a", {
      autostart: 1,
      camera: 0,
      annotations_visible: 1,
      annotation_tooltip_visible: 1,
      dnt: 1,
      success: (api: any) => {
        api.start();
        api.addEventListener("viewerready", () => {
          let tumourVisible = true;
          let tagsVisible = true;
          let tumourMaterial: any = null;
          let originalTumourMaterial: any = null;
          let initialCamera: { position: number[]; target: number[]; fov?: number } | null = null;

          tagsToggle?.removeAttribute("disabled");
          registerModelBackground(api);

          api.getCameraLookAt((cameraError: unknown, camera: { position: number[]; target: number[] }) => {
            if (cameraError || !camera) return;
            api.getFov((fovError: unknown, fov: number) => {
              const zAngle = (540 * Math.PI) / 180;
              const xAngle = (90 * Math.PI) / 180;
              const yAngle = (180 * Math.PI) / 180;
              const offsetX = camera.position[0] - camera.target[0];
              const offsetY = camera.position[1] - camera.target[1];
              const offsetZ = camera.position[2] - camera.target[2];
              const zRotatedX = offsetX * Math.cos(zAngle) - offsetY * Math.sin(zAngle);
              const zRotatedY = offsetX * Math.sin(zAngle) + offsetY * Math.cos(zAngle);
              const xRotatedY = zRotatedY * Math.cos(xAngle) - offsetZ * Math.sin(xAngle);
              const xRotatedZ = zRotatedY * Math.sin(xAngle) + offsetZ * Math.cos(xAngle);
              const rotatedPosition = [
                camera.target[0] + zRotatedX * Math.cos(yAngle) + xRotatedZ * Math.sin(yAngle),
                camera.target[1] + xRotatedY,
                camera.target[2] - zRotatedX * Math.sin(yAngle) + xRotatedZ * Math.cos(yAngle),
              ];
              initialCamera = {
                position: rotatedPosition,
                target: [...camera.target],
                ...(!fovError && Number.isFinite(fov) ? { fov } : {}),
              };
              api.setCameraLookAt(initialCamera.position, initialCamera.target, 0);
              modelReset?.removeAttribute("disabled");
            });
          });

          api.updateAnnotation(0, {
            title: isFrenchDocument ? "Tumeur hypophysaire" : isDutchDocument ? "Hypofysetumor" : isGermanDocument ? "Hypophysentumor" : "Pituitary tumour",
            content: isFrenchDocument ? "Présente de manière asymétrique dans le tissu glandulaire normal." : isDutchDocument ? "Asymmetrisch ingebed in normaal klierweefsel." : isGermanDocument ? "Asymmetrisch in normales Drüsengewebe eingebettet." : "Asymmetrically embedded in normal gland tissue.",
          });
          api.removeAnnotation(1, () => {
            api.updateAnnotation(1, {
              title: isFrenchDocument ? "Cerveau" : isDutchDocument ? "Hersenen" : isGermanDocument ? "Gehirn" : "Brain",
              content: isFrenchDocument ? "Segmentation du cerveau au scanner, représentée en lilas." : isDutchDocument ? "Segmentatie van de hersenen op CT, weergegeven in lila." : isGermanDocument ? "Segmentierung des Gehirns im CT, in Lila dargestellt." : "CT brain segmentation shown in lilac.",
            });
          });

          api.getMaterialList((error: unknown, materials: any[]) => {
            if (error || !materials?.length) return;
            const getColour = (material: any): number[] => {
              for (const channelName of ["AlbedoPBR", "DiffusePBR", "DiffuseColor"]) {
                const colour = material.channels?.[channelName]?.color;
                if (Array.isArray(colour)) return colour;
              }
              return [0, 0, 0];
            };
            const redScore = (material: any) => {
              const [red, green, blue] = getColour(material);
              return red - (green + blue) / 2;
            };
            const greenScore = (material: any) => {
              const [red, green, blue] = getColour(material);
              return green - (red + blue) / 2;
            };
            const setColour = (material: any, colour: number[]) => {
              ["AlbedoPBR", "DiffusePBR", "DiffuseColor"].forEach((channelName) => {
                if (material.channels?.[channelName]) material.channels[channelName].color = colour;
              });
              api.setMaterial(material);
            };

            tumourMaterial = materials.find((material) => /tumou?r/i.test(material.name ?? ""))
              ?? [...materials].sort((a, b) => redScore(b) - redScore(a))[0];
            const skullMaterial = materials.find((material) => /skull|cran/i.test(material.name ?? ""))
              ?? [...materials]
                .filter((material) => material.stateSetID !== tumourMaterial.stateSetID)
                .sort((a, b) => greenScore(b) - greenScore(a))[0];

            materials.forEach((material) => {
              if (material.stateSetID === tumourMaterial.stateSetID) setColour(material, [0.88, 0.04, 0.07]);
              else if (material.stateSetID === skullMaterial?.stateSetID) setColour(material, [0.78, 0.7, 0.92]);
              else setColour(material, [0.58, 0.42, 0.86]);
            });
            originalTumourMaterial = JSON.parse(JSON.stringify(tumourMaterial));
            tumourToggle?.removeAttribute("disabled");
          });

          modelReset?.addEventListener("click", () => {
            if (!initialCamera) return;
            if (typeof initialCamera.fov === "number") api.setFov(initialCamera.fov);
            api.setCameraLookAt(initialCamera.position, initialCamera.target, 0.8);
          });
          tumourToggle?.addEventListener("click", () => {
            if (!tumourMaterial || !originalTumourMaterial) return;
            tumourVisible = !tumourVisible;
            if (tumourVisible) {
              tumourMaterial = JSON.parse(JSON.stringify(originalTumourMaterial));
            } else {
              tumourMaterial = JSON.parse(JSON.stringify(originalTumourMaterial));
              tumourMaterial.channels ??= {};
              tumourMaterial.channels.Opacity = {
                ...(tumourMaterial.channels.Opacity ?? {}),
                enable: true,
                factor: 0,
                type: "BLENDING",
              };
            }
            api.setMaterial(tumourMaterial);
            tumourToggle.setAttribute("aria-pressed", String(tumourVisible));
            tumourToggle.textContent = tumourVisible ? (isFrenchDocument ? "Masquer la tumeur" : isDutchDocument ? "Tumor verbergen" : isGermanDocument ? "Tumor ausblenden" : "Hide Tumor") : (isFrenchDocument ? "Afficher la tumeur" : isDutchDocument ? "Tumor tonen" : isGermanDocument ? "Tumor anzeigen" : "Show Tumor");
          });
          tagsToggle?.addEventListener("click", () => {
            tagsVisible = !tagsVisible;
            [0, 1].forEach((index) => tagsVisible ? api.showAnnotation(index) : api.hideAnnotation(index));
            tagsVisible ? api.showAnnotationTooltips() : api.hideAnnotationTooltips();
            tagsToggle.setAttribute("aria-pressed", String(tagsVisible));
            tagsToggle.textContent = tagsVisible ? (isFrenchDocument ? "Masquer les repères" : isDutchDocument ? "Labels verbergen" : isGermanDocument ? "Labels ausblenden" : "Hide Tags") : (isFrenchDocument ? "Afficher les repères" : isDutchDocument ? "Labels tonen" : isGermanDocument ? "Markierungen anzeigen" : "Show Tags");
          });
        });
      },
      error: () => console.error("The interactive model could not be loaded."),
    });
  }

  const secondSketchfabFrame = document.querySelector<HTMLIFrameElement>("[data-second-sketchfab-viewer]");
  const secondModelReset = document.querySelector<HTMLButtonElement>("[data-second-model-reset]");
  const secondTumourToggle = document.querySelector<HTMLButtonElement>("[data-second-tumour-toggle]");

  const additionalModel = document.querySelector<HTMLElement>("[data-additional-model]");
  const independentModels = [
    { frame: secondSketchfabFrame, reset: secondModelReset, toggle: secondTumourToggle,
      uid: "a2e063b2d65a4a5190e1de85b7e16dcd", tumourName: null },
    { frame: additionalModel?.querySelector<HTMLIFrameElement>("[data-additional-sketchfab-viewer]"),
      reset: additionalModel?.querySelector<HTMLButtonElement>("[data-additional-model-reset]"),
      toggle: additionalModel?.querySelector<HTMLButtonElement>("[data-additional-tumour-toggle]"),
      uid: additionalModel?.dataset.additionalModel, tumourName: "mtl41186" },
  ];
  independentModels.forEach(({ frame, reset: secondModelReset, toggle: secondTumourToggle, uid, tumourName }) => {
    if (!frame || !uid || !SketchfabViewer) return;
    const secondClient = new SketchfabViewer("1.12.1", frame);
    secondClient.init(uid, {
      autostart: 1,
      camera: 0,
      annotations_visible: 0,
      annotation_tooltip_visible: 0,
      dnt: 1,
      success: (api: any) => {
        api.start();
        api.addEventListener("viewerready", () => {
          let tumourVisible = true;
          let tumourMaterial: any = null;
          let visibleTumourMaterial: any = null;
          let secondInitialCamera: { position: number[]; target: number[]; fov?: number } | null = null;

          registerModelBackground(api);

          api.getCameraLookAt((cameraError: unknown, camera: { position: number[]; target: number[] }) => {
            if (cameraError || !camera) return;
            api.getFov((fovError: unknown, fov: number) => {
              secondInitialCamera = {
                position: [...camera.position],
                target: [...camera.target],
                ...(!fovError && Number.isFinite(fov) ? { fov } : {}),
              };
              secondModelReset?.removeAttribute("disabled");
            });
          });

          api.getMaterialList((error: unknown, materials: any[]) => {
            if (error || !materials?.length) return;
            const getColour = (material: any): number[] => {
              for (const channelName of ["AlbedoPBR", "DiffusePBR", "DiffuseColor"]) {
                const colour = material.channels?.[channelName]?.color;
                if (Array.isArray(colour)) return colour;
              }
              return [0, 0, 0];
            };
            const colourScore = (material: any, channel: number) => {
              const colour = getColour(material);
              return colour[channel] - (colour[(channel + 1) % 3] + colour[(channel + 2) % 3]) / 2;
            };
            const setColour = (material: any, colour: number[]) => {
              ["AlbedoPBR", "DiffusePBR", "DiffuseColor"].forEach((channelName) => {
                if (material.channels?.[channelName]) material.channels[channelName].color = colour;
              });
              api.setMaterial(material);
            };

            const brainMaterial = materials.find((material) => /brain/i.test(material.name ?? "") && !/tumou?r/i.test(material.name ?? ""))
              ?? [...materials].sort((a, b) => colourScore(b, 0) - colourScore(a, 0))[0];
            tumourMaterial = materials.find((material) => tumourName ? material.name === tumourName : /tumou?r/i.test(material.name ?? ""))
              ?? [...materials]
                .filter((material) => material.stateSetID !== brainMaterial?.stateSetID)
                .sort((a, b) => colourScore(b, 1) - colourScore(a, 1))[0];

            if (tumourName) {
              materials.filter((material) => material.stateSetID !== tumourMaterial?.stateSetID)
                .forEach((material) => setColour(material, material.name === "mtl1" ? [0.58, 0.42, 0.86] : [0.78, 0.7, 0.92]));
            } else if (brainMaterial) setColour(brainMaterial, [0.58, 0.42, 0.86]);
            if (tumourMaterial) {
              setColour(tumourMaterial, [0.88, 0.04, 0.07]);
              visibleTumourMaterial = JSON.parse(JSON.stringify(tumourMaterial));
              secondTumourToggle?.removeAttribute("disabled");
            }
          });

          secondModelReset?.addEventListener("click", () => {
            if (!secondInitialCamera) return;
            if (typeof secondInitialCamera.fov === "number") api.setFov(secondInitialCamera.fov);
            api.setCameraLookAt(secondInitialCamera.position, secondInitialCamera.target, 0.8);
          });
          secondTumourToggle?.addEventListener("click", () => {
            if (!tumourMaterial || !visibleTumourMaterial) return;
            tumourVisible = !tumourVisible;
            tumourMaterial = JSON.parse(JSON.stringify(visibleTumourMaterial));
            if (!tumourVisible) {
              tumourMaterial.channels ??= {};
              tumourMaterial.channels.Opacity = {
                ...(tumourMaterial.channels.Opacity ?? {}),
                enable: true,
                factor: 0,
                type: "BLENDING",
              };
            }
            api.setMaterial(tumourMaterial);
            secondTumourToggle.setAttribute("aria-pressed", String(tumourVisible));
            secondTumourToggle.textContent = tumourVisible ? (isFrenchDocument ? "Masquer la tumeur" : isDutchDocument ? "Tumor verbergen" : isGermanDocument ? "Tumor ausblenden" : "Hide Tumor") : (isFrenchDocument ? "Afficher la tumeur" : isDutchDocument ? "Tumor tonen" : isGermanDocument ? "Tumor anzeigen" : "Show Tumor");
          });
        });
      },
      error: () => console.error(`The interactive model ${uid} could not be loaded.`),
    });
  });

  document.querySelectorAll<HTMLButtonElement>(".interactive-model-controls button").forEach((button) => {
    button.addEventListener("pointerdown", () => {
      if (button.disabled) return;
      button.classList.remove("is-control-confirmed");
      requestAnimationFrame(() => button.classList.add("is-control-confirmed"));
    });
    button.addEventListener("animationend", () => button.classList.remove("is-control-confirmed"));
  });
</script>

