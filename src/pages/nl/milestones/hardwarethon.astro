---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import FloatingBackControl from "../../../components/common/FloatingBackControl.astro";
---

<BaseLayout locale="nl" title="Hardwarethon Costa Rica 2019 | Diego Carrillo" description="Derde plaats bij Hardwarethon Costa Rica 2019 voor een multidisciplinair technologieprototype ter ondersteuning van de koffieproductie.">
  <section class="relative isolate overflow-hidden px-6 py-8 sm:px-10 lg:px-16">
    <FloatingBackControl href="/nl/#milestones" label="Terug naar mijlpalen" />
    <article class="mx-auto mt-12 max-w-4xl pb-12 sm:mt-14 sm:pb-14">
      <p class="section-eyebrow text-violet-300">MIJLPAAL · COSTA RICA 2019</p>
      <h1 class="interactive-heading page-title mt-5 text-slate-400">Hardwarethon Costa Rica.</h1>
      <p class="body-copy-reference mt-8 max-w-3xl text-slate-300">Een multidisciplinair prototype behaalde de derde plaats tijdens een technologiewedstrijd van 48 uur.</p>
      <section class="mt-10 max-w-3xl border-t border-violet-300/15 pt-8" aria-labelledby="hardwarethon-outcome">
        <p class="section-eyebrow text-violet-300" id="hardwarethon-outcome">HET RESULTAAT</p>
        <p class="body-copy-reference mt-4 text-slate-400">Het team ontwikkelde een werkend concept om koffieproductie in de natuurlijke omgeving te volgen. Het combineerde elektronica, software, materialen, UX/UI en bedrijfsontwerp om lokale producenten en landbouwgemeenschappen te ondersteunen.</p>
      </section>
    </article>
  </section>
</BaseLayout>
