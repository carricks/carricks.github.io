---
import "../styles/global.css";
import Navbar from "../components/layout/Navbar.astro";

export interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Diego Carrillo | Multidisciplinary Systems Engineer",
  description =
    "Portfolio of Diego Carrillo - Multidisciplinary Systems Engineer specialized in Industrial Automation, SCADA, Renewable Energy and Resilient Power Systems.",
} = Astro.props;
---

<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />

  <meta
    name="viewport"
    content="width=device-width, initial-scale=1.0"
  />

  <meta
    name="description"
    content={description}
  />

  <title>{title}</title>
</head>

<body>

  <Navbar />

  <main>
    <slot />
  </main>

  <script>
    const sections = document.querySelectorAll<HTMLElement>("[data-section-transition]");

    if (!window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            entry.target.classList.toggle("is-section-idle", !entry.isIntersecting);
          });
        },
        { threshold: 0.18 },
      );

      sections.forEach((section) => observer.observe(section));
    }
  </script>

</body>

</html>
